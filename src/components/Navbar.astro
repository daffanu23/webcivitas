                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
        </button>

    </div>
)}

<style>
    /* 1. KONTINER UTAMA NAVBAR */
    .sleek-navbar {
        width: 100%;
        position: sticky;
        top: 0;
        z-index: 1000;
        background-color: rgba(var(--bg-rgb, 10, 10, 10), 0.75);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border-bottom: 1px solid var(--border);
        transition: all 0.3s ease;
    }

    :global(body:not(.light)) .sleek-navbar { background-color: rgba(15, 15, 15, 0.8); }
    :global(body.light) .sleek-navbar { background-color: rgba(255, 255, 255, 0.85); }

    .navbar-inner {
        display: flex;
        justify-content: space-between;
        align-items: center;
        height: 60px;
        padding: 0 20px;
        max-width: 1440px; 
        margin: 0 auto;
    }

    /* 2. KIRI: NAVIGASI LITE */
    .nav-left {
        flex: 1; display: flex; justify-content: flex-start; align-items: center; gap: 20px;
    }

    .nav-link {
        color: var(--text-muted); text-decoration: none; 
        font-weight: 400; font-size: 0.9rem; transition: color 0.2s ease;
        position: relative;
    }

    .nav-link::after {
        content: ''; position: absolute; bottom: -4px; left: 0; 
        width: 100%; height: 2px; background-color: var(--text); 
        border-radius: 2px; transform: scaleX(0); transform-origin: left; 
        transition: transform 0.3s ease;
    }

    .nav-link:hover { color: var(--text); }
    .nav-link.active { color: var(--text); font-weight: 500; }
    .nav-link.active::after { transform: scaleX(1); }

    @media (hover: hover) and (pointer: fine) {
        .nav-link:hover::after { transform: scaleX(1); }
    }

    /* 3. TENGAH: BRAND LITE */
    .nav-center { flex: 1; display: flex; justify-content: center; }
    
    .brand-text {
        font-family: 'Poppins', sans-serif; font-weight: 500; font-style: italic;
        font-size: 1rem; color: var(--text); letter-spacing: -0.5px; text-decoration: none;
    }

    /* 4. KANAN: UTILS & AUTH MINIMALIST */
    .nav-right { flex: 1; display: flex; justify-content: flex-end; align-items: center; gap: 12px; }
    
    .time-badge {
        display: flex; align-items: center; gap: 8px; color: var(--text-muted);
        font-size: 0.8rem; font-weight: 400;
    }
    
    .divider { color: var(--border); }
    .util-divider { width: 1px; height: 18px; background-color: var(--border); margin: 0 4px; }

    .theme-btn {
        background: transparent; border: none; cursor: pointer; color: var(--text-muted);
        padding: 6px; border-radius: 50%; display: flex; align-items: center; justify-content: center;
        transition: all 0.2s;
    }
    .theme-btn:hover { color: var(--text); background-color: var(--bg-light); transform: rotate(15deg); }
    .icon-sun { display: block; } .icon-moon { display: none; }
    :global(body.light) .icon-sun { display: none; } :global(body.light) .icon-moon { display: block; }

    .auth-wrapper { display: flex; align-items: center; gap: 8px; }
    
    .btn-login-icon {
        display: flex; align-items: center; justify-content: center; width: 34px; height: 34px;
        text-decoration: none; color: var(--text); background: var(--bg-light);
        border: 1px solid var(--border); border-radius: 50%; transition: all 0.2s ease;
    }
    .btn-login-icon:hover { background: var(--text); color: var(--bg); transform: translateY(-2px); }

    .user-pill {
        display: flex; align-items: center; justify-content: center; text-decoration: none;
        background: transparent; border: 1px solid var(--border); padding: 2px;
        border-radius: 50%; transition: border-color 0.2s ease;
    }
    .user-pill:hover { border-color: var(--text-muted); }
    .avatar-img { width: 30px; height: 30px; border-radius: 50%; object-fit: cover; }

    .btn-logout-icon {
        display: flex; align-items: center; justify-content: center; width: 34px; height: 34px;
        background: transparent; border: 1px solid transparent; border-radius: 50%;
        color: var(--text-muted); cursor: pointer; transition: all 0.2s;
    }
    .btn-logout-icon:hover { background: rgba(220, 38, 38, 0.1); color: #dc2626; }

    /* --- RESPONSIVE MOBILE --- */
    @media (max-width: 900px) {
        .time-badge { display: none; } 
    }

    @media (max-width: 600px) {
        .navbar-inner { padding: 0 15px; }
        .nav-center { display: none; }
        .nav-left { gap: 12px; overflow-x: auto; padding-bottom: 2px; } 
        .nav-left::-webkit-scrollbar { display: none; }
        .nav-link { font-size: 0.85rem; white-space: nowrap; }
        .nav-right { flex: 0; gap: 8px; }
    }

    /* =========================================
       FAB SLIDE-UP MENU (POPOVER) STYLES
       ========================================= */
    .fab-container {
        position: fixed;
        bottom: 40px;
        right: 40px;
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        z-index: 9999;
    }

    /* Menu Menyembul (Bersembunyi secara default) */
    .fab-menu {
        display: flex;
        flex-direction: column;
        gap: 15px;
        margin-bottom: 20px;
        opacity: 0;
        visibility: hidden;
        transform: translateY(20px) scale(0.8);
        transform-origin: bottom center;
        transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    /* Saat Class 'active' ditambahkan oleh JS */
    .fab-menu.active {
        opacity: 1;
        visibility: visible;
        transform: translateY(0) scale(1);
    }

    /* Anak Menu (Item Pilihan) */
    .fab-menu-item {
        display: flex;
        align-items: center;
        gap: 15px;
        text-decoration: none;
        justify-content: flex-end;
    }

    .fab-menu-label {
        background: var(--bg);
        color: var(--text);
        padding: 6px 14px;
        border-radius: 6px;
        font-size: 0.85rem;
        font-weight: 600;
        border: 1px solid var(--border);
        box-shadow: 0 4px 10px rgba(0,0,0,0.1);
        opacity: 0;
        transform: translateX(10px);
        transition: all 0.2s ease;
    }

    /* Ikon Lingkaran Kecil */
    .fab-menu-icon {
        width: 48px;
        height: 48px;
        background: var(--bg-light);
        border: 1px solid var(--border);
        color: var(--text);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 4px 10px rgba(0,0,0,0.1);
        transition: transform 0.2s ease, background 0.2s ease;
    }

    /* Efek Hover per Item */
    .fab-menu-item:hover .fab-menu-icon {
        background: var(--text);
        color: var(--bg);
        transform: scale(1.1);
    }

    .fab-menu-item:hover .fab-menu-label {
        opacity: 1;
        transform: translateX(0);
    }

    /* Tombol Utama (+) */
    .fab-main-btn {
        width: 65px;
        height: 65px;
        background: var(--text);
        color: var(--bg);
        border: none;
        outline: none;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
        cursor: pointer;
        transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275), background 0.3s ease;
    }

    .fab-main-btn:hover {
        background: #ef4444; /* Merah menyala */
        color: #ffffff;
    }

    /* Animasi Putar (+) menjadi (x) saat aktif */
    .fab-main-btn .icon-plus {
        transition: transform 0.3s ease;
    }

    .fab-main-btn.active .icon-plus {
        transform: rotate(45deg); /* Berubah jadi tanda silang X */
    }
    
    .fab-main-btn.active {
        background: var(--bg-light); /* Warna redup saat menu terbuka */
        color: var(--text);
        border: 1px solid var(--border);
    }

    /* Responsif HP */
    @media (max-width: 768px) {
        .fab-container {
            bottom: 25px;
            right: 25px;
        }
        .fab-main-btn {
            width: 55px;
            height: 55px;
        }
        .fab-menu-icon {
            width: 44px;
            height: 44px;
        }
    }
</style>