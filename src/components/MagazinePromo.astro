---
import { getSupabaseServer } from '../lib/supabase';
import { ArrowRight, BookOpen } from 'lucide-react';

const supabase = getSupabaseServer(Astro.cookies);

const { data: latestMagazine, error } = await supabase
    .from('magazines')
    .select('*')
    .order('created_at', { ascending: false })
    .limit(1)
    .single();

if (error || !latestMagazine) {
    return;
}

// --- LOGIKA TEMA WARNA (COLOR CODING) ---
const jenis = latestMagazine.jenis || 'Majalah';
let themeColor = '#ef4444'; // Merah menyala
let themeText = '#ffffff';

if (jenis === 'Tabloid') {
    themeColor = '#3b82f6'; // Biru terang
} else if (jenis === 'Wartabasement') {
    themeColor = '#f59e0b'; // Kuning emas
    themeText = '#1a1a1a';  // Teks tombol gelap khusus untuk warna kuning
}
---

<section class="premium-promo-section container">
    <div class="promo-glass-card" style={`--theme-color: ${themeColor}; --theme-text: ${themeText};`}>
        
        {/* CAHAYA PENDAR (AMBIENT GLOW) DI BELAKANG BUKU */}
        <div class="ambient-glow"></div>

        {/* KIRI: TEKS MINIMALIS */}
        <div class="promo-content">
            <div class="meta-header">
                <span class="badge-jenis">{jenis}</span>
                <span class="meta-angkatan">
                    {latestMagazine.angkatan ? `Angkatan ${latestMagazine.angkatan}` : 'Rilis Terbaru'}
                </span>
            </div>
            
            <h2 class="title">{latestMagazine.title}</h2>
            
            <div class="action-area">
                {/* TOMBOL UTAMA (KAPSUL) */}
                <a href={`/terbitan/${latestMagazine.id}`} class="btn-glow">
                    <BookOpen size={18} /> Baca Edisi Ini
                </a>
                
                {/* TEKS AJAKAN (EXPLORE LINK) */}
                <a href="/terbitan" class="btn-text-explore">
                    Baca Edisi Cetak Kami yang Lain! <ArrowRight size={18} className="arrow-icon" />
                </a>
            </div>
        </div>

        {/* KANAN: COVER BUKU */}
        <div class="promo-visual">
            <img 
                src={latestMagazine.cover_url} 
                alt={`Cover ${latestMagazine.title}`} 
                class="book-cover"
                loading="eager" 
            />
        </div>

    </div>
</section>

<style>
    .premium-promo-section {
        margin-top: 40px;
        margin-bottom: 60px;
    }

    .promo-glass-card {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 45px 60px;
        background: linear-gradient(135deg, rgba(255,255,255,0.03) 0%, rgba(255,255,255,0.01) 100%);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 24px;
        overflow: hidden;
        gap: 40px;
    }

    /* CAHAYA PENDAR LATAR */
    .ambient-glow {
        position: absolute;
        right: 5%;
        top: 50%;
        transform: translateY(-50%);
        width: 300px;
        height: 300px;
        background: var(--theme-color);
        filter: blur(120px);
        opacity: 0.15;
        z-index: 0;
        pointer-events: none;
    }

    /* --- KONTEN KIRI --- */
    .promo-content {
        position: relative;
        z-index: 1;
        flex: 1;
        max-width: 600px;
    }

    .meta-header {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 20px;
    }

    .badge-jenis {
        background: var(--theme-color);
        color: var(--theme-text);
        padding: 4px 14px;
        border-radius: 6px;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .meta-angkatan {
        color: rgba(255,255,255,0.5);
        font-size: 0.9rem;
        font-weight: 500;
    }

    .title {
        color: #ffffff;
        font-size: 1.5rem;
        font-weight: 600;
        line-height: 1.4;
        margin-bottom: 35px;
        letter-spacing: -0.2px;
    }

    /* --- AREA AKSI (SUSUNAN ATAS BAWAH) --- */
    .action-area {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 20px;
    }

    /* 1. Tombol Baca (Kapsul Aerodinamis Glow) */
    .btn-glow {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        padding: 12px 32px;
        border-radius: 50px; 
        font-size: 0.95rem;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.3s ease;
        background: rgba(0, 0, 0, 0.4); 
        color: #ffffff;
        border: 1px solid var(--theme-color);
        box-shadow: 0 0 20px -5px var(--theme-color); 
    }
    
    .btn-glow:hover {
        background: var(--theme-color);
        color: var(--theme-text);
        box-shadow: 0 0 35px 0 var(--theme-color); 
        transform: translateY(-2px);
    }

    /* 2. Teks Ajakan Ke Rak Buku (Elegant Underline) */
    .btn-text-explore {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-size: 0.95rem;
        font-weight: 500;
        color: rgba(255,255,255,0.6); 
        text-decoration: none;
        transition: all 0.3s ease;
        padding-bottom: 4px;
        border-bottom: 1px solid rgba(255,255,255,0.15); /* Garis redup standby */
    }

    .btn-text-explore:hover {
        color: #ffffff; 
        border-bottom-color: var(--theme-color); /* Menyala sesuai warna */
    }

    .btn-text-explore .arrow-icon {
        transition: transform 0.3s ease, color 0.3s ease;
    }
    
    .btn-text-explore:hover .arrow-icon {
        transform: translateX(6px); 
        color: var(--theme-color);
    }

    /* --- VISUAL KANAN (BUKU) --- */
    .promo-visual {
        position: relative;
        z-index: 1;
        flex-shrink: 0;
        perspective: 1000px;
    }

    .book-cover {
        width: 170px;
        height: auto;
        border-radius: 2px 6px 6px 2px;
        transform: rotateY(-15deg) rotateX(4deg);
        box-shadow: 
            -5px 5px 15px rgba(0,0,0,0.4), 
            15px 20px 30px rgba(0,0,0,0.5);
        transition: transform 0.4s ease;
    }

    .promo-visual:hover .book-cover {
        transform: rotateY(-5deg) rotateX(0deg) scale(1.02);
    }

    /* =========================================
       RESPONSIVE MOBILE (CLEAN UI OVERHAUL)
       ========================================= */
    @media (max-width: 768px) {
        .premium-promo-section {
            margin-top: 20px;
            margin-bottom: 40px;
        }

        .promo-glass-card {
            flex-direction: column-reverse;
            text-align: center;
            padding: 35px 20px; /* Padding disusutkan */
            gap: 25px; /* Jarak antar elemen dirapatkan */
        }

        .ambient-glow {
            top: 25%;
            right: 50%;
            transform: translateX(50%);
            width: 200px; /* Pendaran dikecilkan */
            height: 200px;
        }

        .meta-header {
            justify-content: center;
            margin-bottom: 15px;
        }
        
        .badge-jenis {
            font-size: 0.7rem;
        }

        .meta-angkatan {
            font-size: 0.8rem;
        }

        .title {
            font-size: 1.25rem; /* Jauh lebih lega di layar HP */
            line-height: 1.35;
            margin-bottom: 25px;
        }

        .action-area {
            align-items: center;
            width: 100%;
            gap: 15px; /* Jarak antar tombol dirapatkan */
        }

        .btn-glow {
            width: 100%;
            padding: 10px 24px;
            font-size: 0.9rem;
        }
        
        .btn-text-explore {
            font-size: 0.85rem; /* Teks ajakan lebih subtle */
            line-height: 1.4;
            flex-wrap: wrap; /* Mencegah overflow jika teks kepanjangan */
            justify-content: center;
            text-align: center;
        }

        .book-cover {
            width: 130px; /* Sedikit dikecilkan */
            transform: rotateY(0) rotateX(0); 
        }
    }
</style>