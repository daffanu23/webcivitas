---
import Layout from '../../layouts/Layout.astro';
import NewsGraphicGenerator from '../../components/NewsGraphicGenerator.jsx';
import { getSupabaseServer } from '../../lib/supabase';

export const prerender = false;

const supabase = getSupabaseServer(Astro.cookies);
const { data: { user } } = await supabase.auth.getUser();

if (!user) {
    return Astro.redirect('/login');
}

const { data: profile } = await supabase.from('profiles').select('role').eq('id', user.id).single();
if (!profile || profile.role !== 'admin') {
    return Astro.redirect('/');
}
---

<Layout title="Generator Grafis Berita — Admin">
    <div class="generator-page">
        <div class="generator-header">
            <h1>🎨 Generator Grafis Berita</h1>
            <p class="subtitle">Buat gambar berita dengan overlay teks dengan cepat untuk diposting.</p>
        </div>

        <div class="generator-content">
            <NewsGraphicGenerator client:load />
        </div>
    </div>
</Layout>

<style>
    .generator-page {
        max-width: 1200px;
        margin: 0 auto;
        padding: 40px 20px 100px;
    }
    
    .generator-header {
        margin-bottom: 40px;
        text-align: center;
    }
    
    .generator-header h1 {
        font-size: 2.2rem;
        font-weight: 700;
        color: var(--text);
        margin-bottom: 12px;
    }
    
    .subtitle {
        color: var(--text-muted);
        font-size: 1.1rem;
        max-width: 600px;
        margin: 0 auto;
    }

    .generator-content {
        display: flex;
        justify-content: center;
    }
</style>
