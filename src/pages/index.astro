---
import Layout from '../layouts/Layout.astro';
import HeroSlider from '../components/HeroSlider.astro'; 
import SubNewsCard from '../components/SubNewsCard.astro'; 
import MagazinePromo from '../components/MagazinePromo.astro'; 
import { getSupabaseServer } from '../lib/supabase'; 
import CategoryNav from '../components/CategoryNav.astro';
import InstagramPromo from '../components/InstagramPromo.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { Clock, AlertCircle } from 'lucide-react';

const supabase = getSupabaseServer(Astro.cookies);
const activeCat = Astro.url.searchParams.get('kategori') || '';

// --- CEK ROLE (APAKAH ADMIN?) ---
let isAdmin = false;
const { data: { user } } = await supabase.auth.getUser();

if (user) {
    const { data: profile } = await supabase
        .from('profiles')
        .select('role')
        .eq('id', user.id)
        .single();
    
    if (profile?.role === 'admin') {
        isAdmin = true;
    }
}

// --- LOGIKA FETCH BERITA PENDING (HANYA UNTUK ADMIN) ---
let pendingArticles: any[] = []; // <-- TypeScript Error Fixed!
if (isAdmin) {
    const { data } = await supabase
        .from('articles')
        .select(`
            id, title, slug, created_at, cover_url, content, status,
            profiles ( full_name ),
            article_categories ( category_id, categories ( name, slug ) )
        `)
        .eq('status', 'pending')
        .order('created_at', { ascending: false });
        
    pendingArticles = data || [];
}

// --- LOGIKA FETCH BERITA PUBLISHED (UNTUK SEMUA ORANG) ---
let query = supabase
  .from('articles')
  .select(`
    id, title, slug, created_at, cover_url, content, status,
    profiles ( full_name ),
    article_categories ( category_id, categories ( name, slug ) )
  `)
  .eq('status', 'published')
  .order('created_at', { ascending: false });

const { data: allArticles, error } = await query.limit(20);
if (error) console.error("Error fetch news:", error);

let filteredArticles = allArticles || [];

if (activeCat) {
    filteredArticles = filteredArticles.filter(a => {
        const cats = a.article_categories;
        if (Array.isArray(cats)) {
            return cats.some((c: any) => c.categories?.slug === activeCat);
        }
        return false;
    });
}

const heroArticles = filteredArticles.slice(0, 5); 
let gridArticles = [];

if (activeCat) {
    // Jika sedang memilih kategori, kita batasi juga agar tidak kepanjangan
    // (Misal kita kecualikan 5 yang masuk slider, lalu ambil 3 sisanya)
    gridArticles = filteredArticles.slice(5, 8); 
} else {
    // Untuk beranda normal, cukup ambil 3 kartu!
    gridArticles = filteredArticles.slice(5, 8); 
}
---

<Layout title="MEDIACIVITAS - Berita Terkini">

    {/* --- RADAR ADMIN: ANTREAN MENUNGGU ACC --- */}
    {isAdmin && pendingArticles.length > 0 && (
        <div class="admin-radar-section container">
            <div class="admin-radar-header">
                <div class="radar-title">
                    <AlertCircle size={20} />
                    <h3>Menunggu Persetujuan Anda</h3>
                </div>
                <span class="radar-badge">{pendingArticles.length} Draft</span>
            </div>
            
            <div class="radar-grid">
                {pendingArticles.map((item) => (
                    /* LINK SUDAH DIGANTI KE /berita */
                    <a href={`/berita/${item.slug}`} class="radar-card">
                        <div class="radar-img-box">
                            <img src={item.cover_url} alt={item.title} />
                            <div class="radar-status">
                                <Clock size={12} /> Pending
                            </div>
                        </div>
                        <div class="radar-info">
                            <h4>{item.title}</h4>
                            <p>Oleh: {item.profiles?.full_name || 'Redaksi'}</p>
                        </div>
                    </a>
                ))}
            </div>
        </div>
    )}

    <div id="hero-slider-section">
        <HeroSlider slides={heroArticles} />
    </div>

    <MagazinePromo />

    <div class="section-latest container">
        
        <CategoryNav activeSlug={activeCat} />
        
        <div id="dynamic-grid-container">
            {gridArticles.length > 0 ? (
                <>
                    <h3 class="section-label">
                        {activeCat ? `Berita Kategori: ${activeCat}` : 'Berita Terbaru Lainnya'}
                    </h3>
                    <div class="news-grid">
                        {gridArticles.map((item) => (
                            <div class="grid-item">
                                <SubNewsCard article={item} />
                            </div>
                        ))}
                    </div>
                </>
            ) : (
                <div style="text-align: center; padding: 60px 0; color: var(--text-muted);">
                    <p>Belum ada berita lain untuk ditampilkan.</p>
                </div>
            )}
            
            <div class="center-btn">
                {/* LINK TOMBOL JUGA SUDAH DIGANTI KE /berita */}
                <a href={`/berita${activeCat ? '?kategori=' + activeCat : ''}`} class="btn-archive-minimal">
                    <span>Lihat Arsip Lengkap</span>
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M5 12h14"></path>
                        <path d="m12 5 7 7-7 7"></path>
                    </svg>
                </a>
            </div>
        </div>

    </div>
    
    <div class="container">
        <InstagramPromo />
    </div>
    
    <WhatsAppButton />
</Layout>

<style>
    /* Layout Container Global */
    .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 20px;
    }

    /* --- GAYA RADAR ADMIN --- */
    .admin-radar-section {
        margin-top: 30px;
        margin-bottom: 30px;
        background: rgba(239, 68, 68, 0.05);
        border: 1px solid rgba(239, 68, 68, 0.2);
        border-radius: 16px;
        padding: 25px;
    }

    .admin-radar-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
        border-bottom: 1px solid rgba(239, 68, 68, 0.1);
        padding-bottom: 15px;
    }

    .radar-title {
        display: flex;
        align-items: center;
        gap: 10px;
        color: #ef4444; 
    }
    
    .radar-title h3 {
        font-size: 1.1rem;
        font-weight: 700;
        margin: 0;
    }

    .radar-badge {
        background: #ef4444;
        color: #fff;
        padding: 4px 12px;
        border-radius: 50px;
        font-size: 0.8rem;
        font-weight: 700;
    }

    .radar-grid {
        display: flex;
        gap: 20px;
        overflow-x: auto;
        padding-bottom: 10px;
    }
    
    .radar-grid::-webkit-scrollbar { height: 6px; }
    .radar-grid::-webkit-scrollbar-track { background: transparent; }
    .radar-grid::-webkit-scrollbar-thumb { background: rgba(239, 68, 68, 0.2); border-radius: 10px; }

    .radar-card {
        min-width: 250px;
        max-width: 250px;
        background: var(--bg);
        border: 1px solid var(--border);
        border-radius: 12px;
        overflow: hidden;
        text-decoration: none;
        transition: transform 0.2s, box-shadow 0.2s;
    }

    .radar-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 10px 20px rgba(239, 68, 68, 0.15);
        border-color: rgba(239, 68, 68, 0.4);
    }

    .radar-img-box {
        position: relative;
        width: 100%;
        height: 140px;
    }

    .radar-img-box img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .radar-status {
        position: absolute;
        top: 10px;
        right: 10px;
        background: rgba(0, 0, 0, 0.7);
        color: #fca5a5;
        padding: 4px 10px;
        border-radius: 50px;
        font-size: 0.75rem;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 4px;
        backdrop-filter: blur(4px);
    }

    .radar-info {
        padding: 15px;
    }

    .radar-info h4 {
        color: var(--text);
        font-size: 0.95rem;
        font-weight: 600;
        margin: 0 0 8px 0;
        line-height: 1.4;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .radar-info p {
        color: var(--text-muted);
        font-size: 0.8rem;
        margin: 0;
    }


    #hero-slider-section {
        margin-bottom: 0px; 
    }
    
    .section-latest { margin-bottom: 80px; margin-top: 50px; }
    
    .section-label {
        font-size: 1.2rem;
        font-weight: 700;
        margin-bottom: 25px;
        padding-bottom: 15px;
        border-bottom: 1px solid var(--border);
        text-transform: capitalize;
    }

    .news-grid { 
        display: grid; 
        grid-template-columns: repeat(3, 1fr); 
        gap: 30px; 
        margin-bottom: 40px; 
    }
    
    .center-btn { text-align: center; margin-top: 20px; }
    .btn-archive-minimal {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 12px 25px;
        color: var(--text);
        font-weight: 500;
        font-size: 0.95rem;
        transition: all 0.3s ease;
        text-decoration: none;
        border: 1px solid var(--border);
        border-radius: 50px;
    }
    
    .btn-archive-minimal svg { transition: transform 0.3s ease; }
    .btn-archive-minimal:hover { border-color: var(--text); background: var(--bg-light); }
    .btn-archive-minimal:hover svg { transform: translateX(4px); }

    @media (max-width: 900px) { .news-grid { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 600px) { .news-grid { grid-template-columns: 1fr; } }
</style>