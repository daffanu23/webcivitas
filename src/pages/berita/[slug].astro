---
import Layout from '../../layouts/Layout.astro';
import { getSupabaseServer } from '../../lib/supabase'; 
import { Calendar, User, Share2, Bookmark, CheckCircle, XCircle, RotateCcw } from 'lucide-react';

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/404');

const supabase = getSupabaseServer(Astro.cookies);
const { data: { user } } = await supabase.auth.getUser();

let isAdmin = false;
if (user) {
    const { data: profile } = await supabase
        .from('profiles')
        .select('role')
        .eq('id', user.id)
        .single();
    if (profile?.role === 'admin') isAdmin = true;
}

const { data: article, error } = await supabase
    .from('articles')
    .select(`
        *, 
        profiles ( full_name ),
        article_categories ( categories ( name, slug ) ) 
    `)
    .eq('slug', slug)
    .single();

if (error || !article) return Astro.redirect('/404');
if (!isAdmin && article.status !== 'published') return Astro.redirect('/404');

const authorName = article.profiles?.full_name || 'Redaksi';
const publishDate = new Date(article.created_at).toLocaleDateString('id-ID', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });

const htmlContent = article.content || '<p>Konten tidak tersedia.</p>';
const showAdminPanel = isAdmin && article.status === 'pending';
---

{/* 1. KITA LOAD CSS QUILL UNTUK SEMUA ORANG (Agar tampilan baca sama persis dengan editor) */}
<link href="https://cdn.jsdelivr.net/npm/quill@2.0.2/dist/quill.snow.css" rel="stylesheet" />

{/* Script JS editor-nya baru di-load hanya untuk Admin */}
{showAdminPanel && (
    <script is:inline src="https://cdn.jsdelivr.net/npm/quill@2.0.2/dist/quill.js"></script>
    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/dompurify/3.1.5/purify.min.js"></script>
)}

<Layout title={`${article.title} | MEDIACIVITAS`}>

    <article class="article-wrapper">
        
        {showAdminPanel && (
            <div class="admin-action-panel">
                <div class="panel-info">
                    <span class="badge-pending">Menunggu ACC</span>
                    <p>Anda bisa langsung mengedit Judul dan Teks di bawah (Rich Text), lalu klik aksi.</p>
                </div>
                
                <input type="hidden" id="admin-article-id" value={article.id} />
                
                <div class="panel-buttons">
                    <button class="btn-admin-reject" id="btn-reject" title="Tolak Sepenuhnya (Rejected)">
                        <XCircle size={18} /> Tolak
                    </button>
                    <button class="btn-admin-revise" id="btn-revise" title="Kembalikan ke Penulis (Draft)">
                        <RotateCcw size={18} /> Revisi
                    </button>
                    <button class="btn-admin-approve" id="btn-approve" title="Simpan Editan & Tayangkan">
                        <CheckCircle size={18} /> ACC & Tayangkan
                    </button>
                </div>
            </div>
        )}

        <header class="header-section">
            {showAdminPanel ? (
                <textarea id="inline-title" class="main-headline invisible-input auto-resize" rows="1" placeholder="Ketik Judul...">{article.title}</textarea>
            ) : (
                <h1 class="main-headline">{article.title}</h1>
            )}

            <div class="meta-row">
                <div class="meta-pill"><User size={14} /> <span>{authorName}</span></div>
                <div class="meta-pill"><Calendar size={14} /> <span>{publishDate}</span></div>
                
                {article.article_categories && article.article_categories.map((ac: any) => (
                    ac.categories && (
                        <a href={`/berita?kategori=${ac.categories.slug}`} class="meta-pill cat-link">
                            {ac.categories.name}
                        </a>
                    )
                ))}
            </div>
        </header>

        {article.cover_url && (
            <div class="featured-image">
                <img src={article.cover_url} alt={article.title} transition:name={`hero-${slug}`} />
            </div>
        )}

        {/* 2. STRUKTUR PEMBACA QUILL SINKRON */}
        {showAdminPanel ? (
            <div class="text-mode-area">
                <div id="quill-toolbar" class="sleek-toolbar">
                    <span class="ql-formats">
                        <button class="ql-bold" title="Tebal"></button>
                        <button class="ql-italic" title="Miring"></button>
                        <button class="ql-underline" title="Garis Bawah"></button>
                    </span>
                    <span class="ql-formats">
                        <button class="ql-header" value="2" title="Sub-Judul (H2)"></button>
                        <button class="ql-header" value="3" title="Sub-Judul Kecil (H3)"></button>
                    </span>
                    <span class="ql-formats">
                        <button class="ql-list" value="ordered" title="Daftar Angka"></button>
                        <button class="ql-list" value="bullet" title="Daftar Titik"></button>
                    </span>
                </div>
                <div id="inline-content-editor" class="article-content text-editor">
                    <Fragment set:html={htmlContent} />
                </div>
            </div>
        ) : (
            // BUNGKUS DENGAN ql-snow dan ql-editor AGAR MENIRU TAMPILAN ASLI EDITOR!
            <div class="article-content ql-snow">
                <div class="ql-editor" style="padding: 0;" set:html={htmlContent}></div>
            </div>
        )}

        {article.status === 'published' && (
            <div class="footer-actions">
                <button class="action-btn" id="share-btn" data-url={Astro.url.href}><Share2 size={18} /> <span>Bagikan</span></button>
                <button class="action-btn" id="bookmark-btn" data-id={article.id}><Bookmark size={18} className="icon-bookmark" /> <span id="bookmark-text">Simpan</span></button>
            </div>
        )}
    </article>

</Layout>

<script>
    import { supabase } from '../../lib/supabase';
    
    document.addEventListener('astro:page-load', async () => {
        
        const textareas = document.querySelectorAll('.auto-resize');
        function resizeTextarea(el: HTMLTextAreaElement) {
            el.style.height = 'auto'; el.style.height = (el.scrollHeight) + 'px';
        }
        textareas.forEach(el => {
            const textarea = el as HTMLTextAreaElement;
            if(textarea.value) resizeTextarea(textarea);
            textarea.addEventListener('input', function() { resizeTextarea(this); });
        });

        let adminQuill: any = null;
        if (document.getElementById('inline-content-editor') && typeof window !== 'undefined' && (window as any).Quill) {
            adminQuill = new (window as any).Quill('#inline-content-editor', {
                theme: 'snow',
                modules: { toolbar: '#quill-toolbar' },
                placeholder: 'Edit teks artikel...'
            });
        }

        const articleId = document.getElementById('admin-article-id') as HTMLInputElement;

        async function processAdminAction(newStatus: string, confirmMsg: string, successMsg: string, btnId: string) {
            if (!confirm(confirmMsg)) return;
            
            const btn = document.getElementById(btnId);
            const originalText = btn ? btn.innerHTML : '';
            if (btn) btn.innerHTML = "Memproses...";

            const updateData: any = { status: newStatus };
            
            const titleInput = document.getElementById('inline-title') as HTMLTextAreaElement;
            if (titleInput) updateData.title = titleInput.value.trim();

            if (adminQuill) {
                let rawHtml = adminQuill.root.innerHTML;
                if (rawHtml === '<p><br></p>') rawHtml = ''; 
                updateData.content = (window as any).DOMPurify ? (window as any).DOMPurify.sanitize(rawHtml) : rawHtml;
            }

            const { error } = await supabase
                .from('articles')
                .update(updateData)
                .eq('id', articleId.value);
                
            if (error) {
                alert("Gagal memproses: " + error.message);
                if (btn) btn.innerHTML = originalText;
            } else {
                alert(successMsg);
                if (newStatus === 'published') {
                    window.location.reload(); 
                } else {
                    window.location.href = '/'; 
                }
            }
        }

        if (articleId) {
            document.getElementById('btn-approve')?.addEventListener('click', () => 
                processAdminAction('published', 'ACC dan tayangkan ke publik dengan editan ini?', 'BOM! 🚀 Artikel berhasil ditayangkan!', 'btn-approve')
            );
            document.getElementById('btn-revise')?.addEventListener('click', () => 
                processAdminAction('draft', 'Kembalikan artikel ini ke penulis (Draft) untuk direvisi?', 'Artikel dikembalikan ke status Draft.', 'btn-revise')
            );
            document.getElementById('btn-reject')?.addEventListener('click', () => 
                processAdminAction('rejected', 'Tolak artikel ini secara permanen (Rejected)?', 'Artikel telah ditolak (Rejected).', 'btn-reject')
            );
        }

        const btnShare = document.getElementById('share-btn');
        if (btnShare) {
            btnShare.addEventListener('click', () => {
                const url = btnShare.getAttribute('data-url');
                if (url) {
                    navigator.clipboard.writeText(url).then(() => {
                        const originalHTML = btnShare.innerHTML;
                        btnShare.innerHTML = `<span>Disalin!</span>`;
                        setTimeout(() => btnShare.innerHTML = originalHTML, 2000);
                    });
                }
            });
        }
        
        const btnBookmark = document.getElementById('bookmark-btn');
        const iconBookmark = document.querySelector('.icon-bookmark');
        const textBookmark = document.getElementById('bookmark-text');
        
        if (btnBookmark && iconBookmark) {
            const bArticleId = btnBookmark.getAttribute('data-id');
            const { data: { session } } = await supabase.auth.getSession();
            
            if (session) {
                const { data } = await supabase.from('bookmarks').select('id').eq('user_id', session.user.id).eq('article_id', bArticleId).single();
                if (data) {
                    btnBookmark.classList.add('saved'); iconBookmark.setAttribute('fill', 'currentColor'); if(textBookmark) textBookmark.innerText = "Tersimpan";
                }
            }
            
            btnBookmark.addEventListener('click', async () => {
                if (!session) return window.location.href = '/login';
                const isSaved = btnBookmark.classList.contains('saved');
                if (isSaved) {
                    const { error } = await supabase.from('bookmarks').delete().eq('user_id', session.user.id).eq('article_id', bArticleId);
                    if (!error) { btnBookmark.classList.remove('saved'); iconBookmark.setAttribute('fill', 'none'); if(textBookmark) textBookmark.innerText = "Simpan"; }
                } else {
                    const { error } = await supabase.from('bookmarks').insert({ user_id: session.user.id, article_id: bArticleId });
                    if (!error) { btnBookmark.classList.add('saved'); iconBookmark.setAttribute('fill', 'currentColor'); if(textBookmark) textBookmark.innerText = "Tersimpan"; }
                }
            });
        }
    });
</script>

<style>
    /* --- CSS PANEL DEWA (ADMIN) --- */
    .admin-action-panel { background: var(--bg-light); border: 1px solid var(--border); border-radius: 12px; padding: 20px; margin-bottom: 40px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 20px; box-shadow: 0 10px 30px rgba(0,0,0,0.05); }
    .panel-info { display: flex; flex-direction: column; gap: 8px; }
    .badge-pending { background: rgba(239, 68, 68, 0.1); color: #ef4444; padding: 6px 12px; border-radius: 50px; font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; align-self: flex-start; border: 1px solid rgba(239, 68, 68, 0.2); }
    .panel-info p { margin: 0; font-size: 0.9rem; color: var(--text-muted); }
    .panel-buttons { display: flex; gap: 10px; }
    .btn-admin-reject, .btn-admin-revise, .btn-admin-approve { display: flex; align-items: center; gap: 8px; padding: 10px 18px; border-radius: 50px; font-size: 0.9rem; font-weight: 600; cursor: pointer; transition: all 0.2s; text-decoration: none; }
    .btn-admin-reject { background: transparent; border: 1px solid var(--border); color: var(--text); }
    .btn-admin-reject:hover { background: rgba(239, 68, 68, 0.1); color: #ef4444; border-color: rgba(239, 68, 68, 0.3); }
    .btn-admin-revise { background: var(--bg-light); border: 1px solid var(--border); color: var(--text); }
    .btn-admin-revise:hover { background: #f59e0b; color: #fff; border-color: #f59e0b; }
    .btn-admin-approve { background: var(--text); border: 1px solid var(--text); color: var(--bg); }
    .btn-admin-approve:hover { background: #10b981; border-color: #10b981; box-shadow: 0 5px 15px rgba(16, 185, 129, 0.3); transform: translateY(-2px); }

    /* --- INLINE EDITING CSS --- */
    .invisible-input { width: 100%; background: transparent; border: none; outline: none; color: var(--text); resize: none; overflow: hidden; }
    .main-headline.invisible-input { text-align: center; }
    .main-headline.invisible-input:hover, .main-headline.invisible-input:focus { border-bottom: 2px dashed var(--border); }
    .sleek-toolbar { border: none !important; border-bottom: 1px solid var(--border-muted) !important; padding: 10px 0 !important; margin-bottom: 20px; text-align: center; opacity: 0.7; transition: opacity 0.3s ease; }
    .sleek-toolbar:hover, .text-mode-area:focus-within .sleek-toolbar { opacity: 1; }
    :global(.ql-snow .ql-stroke) { stroke: var(--text) !important; }
    :global(.ql-snow .ql-fill) { fill: var(--text) !important; }
    :global(.ql-snow .ql-picker) { color: var(--text) !important; }
    :global(.ql-snow.ql-toolbar button:hover .ql-stroke) { stroke: var(--theme-color, #ef4444) !important; }
    .text-editor { font-family: 'Poppins', sans-serif; font-size: 1.05rem; line-height: 1.8; text-align: left; border: none !important; padding: 0 10px !important; border-left: 2px dashed transparent !important; transition: border-color 0.2s; }
    .text-editor:hover, .text-editor:focus-within { border-left: 2px dashed var(--border) !important; }
    
    /* Mencegah padding editor default */
    :global(.ql-editor) { padding: 0 !important; }

    /* --- CSS BAWAAN HALAMAN BACA (Kini steril dari pengacau) --- */
    .article-wrapper { width: 100%; max-width: 800px; margin: 0 auto; padding: 40px 20px 100px 20px; box-sizing: border-box; }
    .header-section { text-align: center; margin-bottom: 40px; }
    .main-headline { font-family: 'Poppins', sans-serif; font-size: 2.2rem; font-weight: 700; line-height: 1.3; color: var(--text); margin-bottom: 20px; word-break: normal; overflow-wrap: break-word; }
    .meta-row { display: flex; justify-content: center; gap: 10px; flex-wrap: wrap; }
    .meta-pill { display: flex; align-items: center; gap: 6px; background: var(--bg-light); border: 1px solid var(--border-muted); padding: 6px 12px; border-radius: 50px; font-size: 0.8rem; font-weight: 600; color: var(--text-muted); }
    .featured-image { width: 100%; margin-bottom: 40px; border-radius: 12px; overflow: hidden; border: 1px solid var(--border-muted); }
    .featured-image img { width: 100%; height: auto; display: block; }

    /* Pastikan font keluarga pembaca sesuai */
    .article-content {
        font-family: 'Poppins', sans-serif; font-size: 1.05rem; line-height: 1.8; color: var(--text);
        text-align: left;
    }

    /* KITA HAPUS MANUAL CSS :global(p) { margin-bottom: 1.5em; } KARENA ITU PENYEBABNYA! */

    .footer-actions { margin-top: 60px; padding-top: 30px; border-top: 1px solid var(--border-muted); display: flex; justify-content: center; gap: 15px; }
    .action-btn { background: transparent; border: 1px solid var(--border); padding: 10px 20px; border-radius: 50px; cursor: pointer; display: flex; align-items: center; gap: 8px; font-weight: 600; color: var(--text); transition: all 0.2s; }
    .action-btn:hover { background: var(--text); color: var(--bg); border-color: var(--text); }
    .action-btn.saved { background: var(--text); color: var(--bg); border-color: var(--text); }
    
    @media (max-width: 600px) { .article-wrapper { padding-left: 10px; padding-right: 10px; } }
    .cat-link { text-decoration: none; cursor: pointer; transition: all 0.2s; }
    .cat-link:hover { background: var(--text) !important; color: var(--bg) !important; border-color: var(--text) !important; }
</style>