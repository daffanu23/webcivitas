---
import Layout from '../../layouts/Layout.astro';
import { getSupabaseServer } from '../../lib/supabase'; 
import { Calendar, User, Share2, Bookmark, CheckCircle, XCircle, RotateCcw, Lock, Unlock, Save, PenTool, Palette } from 'lucide-react'; 
import ArticleMetaFields from '../../components/ArticleMetaFields.jsx';

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/404');

const supabase = getSupabaseServer(Astro.cookies);
const { data: { user } } = await supabase.auth.getUser();

let isAdmin = false;
if (user) {
    const { data: profile } = await supabase
        .from('profiles')
        .select('role')
        .eq('id', user.id)
        .single();
    if (profile?.role === 'admin') isAdmin = true;
}

const { data: article, error } = await supabase
    .from('articles')
    .select(`
        *, 
        profiles!author_id ( full_name ),
        editor:profiles!editor_id ( full_name ),
        layouter:profiles!layouter_id ( full_name ),
        article_categories ( categories ( name, slug ) ) 
    `)
    .eq('slug', slug)
    .single();

if (error || !article) return Astro.redirect('/404');
if (!isAdmin && article.status !== 'published') return Astro.redirect('/404');

const authorName = article.profiles?.full_name || 'Redaksi';
const editorName = article.editor?.full_name || null;
const layouterName = article.layouter?.full_name || null;
const publishDate = new Date(article.created_at).toLocaleDateString('id-ID', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });

const htmlContent = article.content || '<p>Konten tidak tersedia.</p>';

// Ambil data kategori untuk dipakai di dropdown mode admin
const { data: categories } = await supabase.from('categories').select('*').order('name');

// TAMBAHAN: Logika Mode Dewa
const showAdminPanel = isAdmin && article.status === 'pending';
const isPending = article.status === 'pending';
const initialEditMode = isAdmin && isPending;
---

{/* 1. KITA LOAD CSS QUILL UNTUK SEMUA ORANG (Agar tampilan baca sama persis dengan editor) */}
<link href="https://cdn.jsdelivr.net/npm/quill@2.0.2/dist/quill.snow.css" rel="stylesheet" />

{/* Script JS editor-nya baru di-load hanya untuk Admin */}
{isAdmin && (
    <script is:inline src="https://cdn.jsdelivr.net/npm/quill@2.0.2/dist/quill.js"></script>
    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/dompurify/3.1.5/purify.min.js"></script>
)}

<Layout title={`${article.title} | MEDIACIVITAS`}>

    <article class="article-wrapper">
        
        {/* TAMBAHAN: TOMBOL TOGGLE PENGAMAN */}
        {isAdmin && !isPending && (
            <button id="btn-toggle-admin" class="floating-admin-toggle">
                <span class="icon-lock"><Lock size={18} /></span>
                <span class="icon-unlock hidden"><Unlock size={18} /></span>
                <span class="toggle-text">Buka Mode Admin</span>
            </button>
        )}

        {/* TAMBAHAN: Panel dibungkus div untuk di-hide/show jika sudah tayang */}
        {isAdmin && (
            <div id="admin-action-panel" class={`admin-action-panel ${initialEditMode ? '' : 'hidden'}`}>
                <div class="panel-info">
                    <span class="badge-pending">{isPending ? 'Menunggu ACC' : 'Mode Admin Aktif'}</span>
                    <p>{isPending ? 'Anda bisa langsung mengedit Judul dan Teks di bawah (Rich Text), lalu klik aksi.' : 'Edit teks bebas, takedown, atau kembalikan ke revisi.'}</p>
                </div>
                
                <input type="hidden" id="admin-article-id" value={article.id} />
                
                <div class="panel-buttons">
                    {isPending ? (
                        <>
                            <button class="btn-admin-reject" id="btn-reject" title="Tolak Sepenuhnya (Rejected)">
                                <XCircle size={18} /> Tolak
                            </button>
                            <button class="btn-admin-revise" id="btn-revise" title="Kembalikan ke Penulis (Draft)">
                                <RotateCcw size={18} /> Revisi
                            </button>
                            <button class="btn-admin-approve" id="btn-approve" title="Simpan Editan & Tayangkan">
                                <CheckCircle size={18} /> ACC & Tayangkan
                            </button>
                        </>
                    ) : (
                        <>
                            <button class="btn-admin-reject" id="btn-takedown" title="Tarik dari peredaran (Rejected)"><XCircle size={18} /> Takedown</button>
                            <button class="btn-admin-revise" id="btn-draft" title="Kembalikan ke Penulis (Draft)"><RotateCcw size={18} /> Jadikan Draft</button>
                            <button class="btn-admin-approve" id="btn-update-text" title="Simpan perubahan teks saja"><Save size={18} /> Simpan Teks</button>
                        </>
                    )}
                </div>
            </div>
        )}

        <header class="header-section">
            {/* TAMBAHAN: Render text normal DAN textarea editor sekaligus, diatur hidden/shownya */}
            <h1 id="view-title" class={`main-headline ${initialEditMode ? 'hidden' : ''}`}>{article.title}</h1>
            
            {isAdmin && (
                <textarea id="edit-title" class={`main-headline invisible-input auto-resize ${initialEditMode ? '' : 'hidden'}`} rows="1" placeholder="Ketik Judul...">{article.title}</textarea>
            )}

            <div id="meta-view-mode" class={`meta-row ${initialEditMode ? 'hidden' : ''}`}>
                <div class="meta-pill"><User size={14} /> <span>{authorName}</span></div>
                <div class="meta-pill"><Calendar size={14} /> <span>{publishDate}</span></div>
                {editorName && <div class="meta-pill"><PenTool size={14} /> <span>Editor: {editorName}</span></div>}
                {layouterName && <div class="meta-pill"><Palette size={14} /> <span>Layouter: {layouterName}</span></div>}
                
                {article.article_categories && article.article_categories.map((ac: any) => (
                    ac.categories && (
                        <a href={`/berita?kategori=${ac.categories.slug}`} class="meta-pill cat-link">
                            {ac.categories.name}
                        </a>
                    )
                ))}
            </div>

            {isAdmin && (
                <div id="meta-edit-mode" class={initialEditMode ? '' : 'hidden'}>
                    <ArticleMetaFields 
                        client:load 
                        isAdmin={isAdmin}
                        categories={(categories || []) as any}
                        initialCategory={article.article_categories?.[0]?.categories?.id || ''}
                        initialAuthor={article.author_id || ''}
                        initialEditor={article.editor_id || ''}
                        initialLayouter={article.layouter_id || ''}
                        currentUserId={user?.id}
                        currentUserName={article.profiles?.full_name || 'Redaksi'}
                    />
                </div>
            )}
        </header>

        {article.cover_url && (
            <div class="featured-image">
                <img src={article.cover_url} alt={article.title} transition:name={`hero-${slug}`} />
            </div>
        )}

        {/* TAMBAHAN: Pisahkan mode View dan Edit */}
        <div id="view-content" class={`article-content ql-snow ${initialEditMode ? 'hidden' : ''}`}>
            <div class="ql-editor" style="padding: 0;" set:html={htmlContent}></div>
        </div>

        {isAdmin && (
            <div id="edit-content-wrapper" class={`text-mode-area ${initialEditMode ? '' : 'hidden'}`}>
                <div id="quill-toolbar" class="sleek-toolbar">
                    <span class="ql-formats">
                        <button class="ql-bold" title="Tebal"></button>
                        <button class="ql-italic" title="Miring"></button>
                        <button class="ql-underline" title="Garis Bawah"></button>
                    </span>
                    <span class="ql-formats">
                        <button class="ql-header" value="2" title="Sub-Judul (H2)"></button>
                        <button class="ql-header" value="3" title="Sub-Judul Kecil (H3)"></button>
                    </span>
                    <span class="ql-formats">
                        <button class="ql-list" value="ordered" title="Daftar Angka"></button>
                        <button class="ql-list" value="bullet" title="Daftar Titik"></button>
                    </span>
                </div>
                <div id="inline-content-editor" class="article-content text-editor">
                    <Fragment set:html={htmlContent} />
                </div>
            </div>
        )}

        <div id="footer-actions-view" class={`footer-actions ${initialEditMode ? 'hidden' : ''}`}>
            {article.status === 'published' && (
                <>
                    <button class="action-btn" id="share-btn" data-url={Astro.url.href}><Share2 size={18} /> <span>Bagikan</span></button>
                    <button class="action-btn" id="bookmark-btn" data-id={article.id}><Bookmark size={18} className="icon-bookmark" /> <span id="bookmark-text">Simpan</span></button>
                </>
            )}
        </div>
    </article>

</Layout>

<script>
    import { supabase } from '../../lib/supabase';
    
    document.addEventListener('astro:page-load', async () => {
        
        const textareas = document.querySelectorAll('.auto-resize');
        function resizeTextarea(el: HTMLTextAreaElement) {
            el.style.height = 'auto'; el.style.height = (el.scrollHeight) + 'px';
        }
        textareas.forEach(el => {
            const textarea = el as HTMLTextAreaElement;
            if(textarea.value) resizeTextarea(textarea);
            textarea.addEventListener('input', function() { resizeTextarea(this); });
        });

        // TAMBAHAN: Setup Quill dipindah ke function agar bisa dipanggil saat tombol diklik
        let adminQuill: any = null;
        function initQuillOnce() {
            if (!adminQuill && document.getElementById('inline-content-editor') && typeof window !== 'undefined' && (window as any).Quill) {
                adminQuill = new (window as any).Quill('#inline-content-editor', {
                    theme: 'snow',
                    modules: { toolbar: '#quill-toolbar' },
                    placeholder: 'Edit teks artikel...'
                });
            }
        }

        let isEditMode = !document.getElementById('edit-content-wrapper')?.classList.contains('hidden');
        if (isEditMode) initQuillOnce();

        // TAMBAHAN: Aksi Klik Tombol Toggle
        const btnToggleAdmin = document.getElementById('btn-toggle-admin');
        if (btnToggleAdmin) {
            btnToggleAdmin.addEventListener('click', () => {
                isEditMode = !isEditMode; 
                initQuillOnce(); 
                
                const iconLock = btnToggleAdmin.querySelector('.icon-lock');
                const iconUnlock = btnToggleAdmin.querySelector('.icon-unlock');
                const toggleText = btnToggleAdmin.querySelector('.toggle-text');
                
                document.getElementById('view-title')?.classList.toggle('hidden', isEditMode);
                document.getElementById('edit-title')?.classList.toggle('hidden', !isEditMode);
                document.getElementById('meta-view-mode')?.classList.toggle('hidden', isEditMode);
                document.getElementById('meta-edit-mode')?.classList.toggle('hidden', !isEditMode);
                document.getElementById('view-content')?.classList.toggle('hidden', isEditMode);
                document.getElementById('edit-content-wrapper')?.classList.toggle('hidden', !isEditMode);
                document.getElementById('admin-action-panel')?.classList.toggle('hidden', !isEditMode);
                document.getElementById('footer-actions-view')?.classList.toggle('hidden', isEditMode);

                if (isEditMode) {
                    btnToggleAdmin.classList.add('active');
                    if (toggleText) toggleText.textContent = "Tutup Mode Admin";
                    iconLock?.classList.add('hidden');
                    iconUnlock?.classList.remove('hidden');
                    const editTitle = document.getElementById('edit-title');
                    if (editTitle) resizeTextarea(editTitle as HTMLTextAreaElement);
                } else {
                    btnToggleAdmin.classList.remove('active');
                    if (toggleText) toggleText.textContent = "Buka Mode Admin";
                    iconLock?.classList.remove('hidden');
                    iconUnlock?.classList.add('hidden');
                }
            });
        }

        const articleId = document.getElementById('admin-article-id') as HTMLInputElement;

        async function processAdminAction(newStatus: string, confirmMsg: string, successMsg: string, btnId: string) {
            if (!confirm(confirmMsg)) return;
            
            const btn = document.getElementById(btnId);
            const originalText = btn ? btn.innerHTML : '';
            if (btn) btn.innerHTML = "Memproses...";

            const updateData: any = { status: newStatus };
            
            const titleInput = document.getElementById('edit-title') as HTMLTextAreaElement;
            if (titleInput) updateData.title = titleInput.value.trim();

            const categoryInput = document.getElementById('input-category') as HTMLInputElement;
            const authorInput = document.getElementById('input-author') as HTMLInputElement;
            const editorInput = document.getElementById('input-editor') as HTMLInputElement;
            const layouterInput = document.getElementById('input-layouter') as HTMLInputElement;

            if (authorInput) updateData.author_id = authorInput.value || null;
            if (editorInput) updateData.editor_id = editorInput.value || null;
            if (layouterInput) updateData.layouter_id = layouterInput.value || null;

            if (adminQuill) {
                let rawHtml = adminQuill.root.innerHTML;
                if (rawHtml === '<p><br></p>') rawHtml = ''; 
                updateData.content = (window as any).DOMPurify ? (window as any).DOMPurify.sanitize(rawHtml) : rawHtml;
            }

            const { error } = await supabase
                .from('articles')
                .update(updateData)
                .eq('id', articleId.value);
                
            // Update kategori di tabel article_categories jika categoryInput ada (Admin Mode)
            if (categoryInput && categoryInput.value && !error) {
                await supabase.from('article_categories').delete().eq('article_id', articleId.value);
                await supabase.from('article_categories').insert({ article_id: articleId.value, category_id: categoryInput.value });
            }
                
            if (error) {
                alert("Gagal memproses: " + error.message);
                if (btn) btn.innerHTML = originalText;
            } else {
                alert(successMsg);
                if (newStatus === 'published') {
                    window.location.reload(); 
                } else {
                    window.location.href = '/'; 
                }
            }
        }

        if (articleId) {
            // Tombol Pending
            document.getElementById('btn-approve')?.addEventListener('click', () => 
                processAdminAction('published', 'ACC dan tayangkan ke publik dengan editan ini?', 'BOM! 🚀 Artikel berhasil ditayangkan!', 'btn-approve')
            );
            document.getElementById('btn-revise')?.addEventListener('click', () => 
                processAdminAction('draft', 'Kembalikan artikel ini ke penulis (Draft) untuk direvisi?', 'Artikel dikembalikan ke status Draft.', 'btn-revise')
            );
            document.getElementById('btn-reject')?.addEventListener('click', () => 
                processAdminAction('rejected', 'Tolak artikel ini secara permanen (Rejected)?', 'Artikel telah ditolak (Rejected).', 'btn-reject')
            );

            // TAMBAHAN: Tombol Published Mode
            document.getElementById('btn-takedown')?.addEventListener('click', () => 
                processAdminAction('rejected', 'Yakin ingin melakukan TAKEDOWN pada artikel ini?', 'Artikel berhasil di-takedown.', 'btn-takedown')
            );
            document.getElementById('btn-draft')?.addEventListener('click', () => 
                processAdminAction('draft', 'Tarik artikel ini ke Draft untuk direvisi?', 'Artikel ditarik menjadi Draft.', 'btn-draft')
            );
            document.getElementById('btn-update-text')?.addEventListener('click', () => 
                processAdminAction('published', 'Simpan perbaikan teks pada artikel ini?', 'Perbaikan teks berhasil disimpan!', 'btn-update-text')
            );
        }

        const btnShare = document.getElementById('share-btn');
        if (btnShare) {
            btnShare.addEventListener('click', () => {
                const url = btnShare.getAttribute('data-url');
                if (url) {
                    navigator.clipboard.writeText(url).then(() => {
                        const originalHTML = btnShare.innerHTML;
                        btnShare.innerHTML = `<span>Disalin!</span>`;
                        setTimeout(() => btnShare.innerHTML = originalHTML, 2000);
                    });
                }
            });
        }
        
        const btnBookmark = document.getElementById('bookmark-btn');
        const iconBookmark = document.querySelector('.icon-bookmark');
        const textBookmark = document.getElementById('bookmark-text');
        
        if (btnBookmark && iconBookmark) {
            const bArticleId = btnBookmark.getAttribute('data-id');
            const { data: { session } } = await supabase.auth.getSession();
            
            if (session) {
                const { data } = await supabase.from('bookmarks').select('id').eq('user_id', session.user.id).eq('article_id', bArticleId).single();
                if (data) {
                    btnBookmark.classList.add('saved'); iconBookmark.setAttribute('fill', 'currentColor'); if(textBookmark) textBookmark.innerText = "Tersimpan";
                }
            }
            
            btnBookmark.addEventListener('click', async () => {
                if (!session) return window.location.href = '/login';
                const isSaved = btnBookmark.classList.contains('saved');
                if (isSaved) {
                    const { error } = await supabase.from('bookmarks').delete().eq('user_id', session.user.id).eq('article_id', bArticleId);
                    if (!error) { btnBookmark.classList.remove('saved'); iconBookmark.setAttribute('fill', 'none'); if(textBookmark) textBookmark.innerText = "Simpan"; }
                } else {
                    const { error } = await supabase.from('bookmarks').insert({ user_id: session.user.id, article_id: bArticleId });
                    if (!error) { btnBookmark.classList.add('saved'); iconBookmark.setAttribute('fill', 'currentColor'); if(textBookmark) textBookmark.innerText = "Tersimpan"; }
                }
            });
        }
    });
</script>

<style>
    /* =========================================
       CSS GLOBAL & DESKTOP 
       ========================================= */
    .hidden { display: none !important; }

    /* --- TOMBOL TOGGLE PENGAMAN (FIX HIT AREA & UX DIPERBESAR) --- */
    .floating-admin-toggle {
        position: fixed; bottom: 100px; right: 30px; 
        z-index: 9999; /* Ditingkatkan ke kasta tertinggi */
        background: var(--bg-light); border: 2px solid var(--text); color: var(--text);
        padding: 14px 28px; /* Tampilan Desktop Gemuk */
        border-radius: 50px; display: flex; align-items: center; gap: 12px;
        font-weight: 700; font-family: 'Poppins', sans-serif; font-size: 1rem; 
        cursor: pointer;
        box-shadow: 0 10px 25px rgba(0,0,0,0.15); 
        transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }
    .floating-admin-toggle :global(svg) { width: 20px; height: 20px; transition: transform 0.3s ease; }
    .floating-admin-toggle:hover { transform: translateY(-4px) scale(1.05); box-shadow: 0 15px 30px rgba(0,0,0,0.2); }
    .floating-admin-toggle.active { background: #ef4444; color: #fff; border-color: #ef4444; }
    .floating-admin-toggle.active :global(svg) { transform: scale(1.2); }

    /* --- CSS PANEL DEWA (ADMIN) --- */
    .admin-action-panel { background: var(--bg-light); border: 1px solid var(--border); border-radius: 12px; padding: 20px; margin-bottom: 40px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 20px; box-shadow: 0 10px 30px rgba(0,0,0,0.05); }
    .panel-info { display: flex; flex-direction: column; gap: 8px; }
    .badge-pending { background: rgba(239, 68, 68, 0.1); color: #ef4444; padding: 6px 12px; border-radius: 50px; font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; align-self: flex-start; border: 1px solid rgba(239, 68, 68, 0.2); }
    .panel-info p { margin: 0; font-size: 0.9rem; color: var(--text-muted); }
    .panel-buttons { display: flex; gap: 10px; flex-wrap: wrap; }
    
    .btn-admin-reject, .btn-admin-revise, .btn-admin-approve { display: flex; align-items: center; gap: 8px; padding: 10px 18px; border-radius: 50px; font-size: 0.9rem; font-weight: 600; cursor: pointer; transition: all 0.2s; border: 1px solid transparent; }
    .btn-admin-reject { background: rgba(239, 68, 68, 0.1); color: #ef4444; border-color: rgba(239, 68, 68, 0.3); }
    .btn-admin-reject:hover { background: #ef4444; color: #fff; }
    .btn-admin-revise { background: var(--bg-light); border-color: var(--border); color: var(--text); }
    .btn-admin-revise:hover { background: #f59e0b; color: #fff; border-color: #f59e0b; }
    .btn-admin-approve { background: var(--text); color: var(--bg); }
    .btn-admin-approve:hover { background: #10b981; border-color: #10b981; box-shadow: 0 5px 15px rgba(16, 185, 129, 0.3); transform: translateY(-2px); }

    /* --- INLINE EDITING CSS --- */
    .invisible-input { width: 100%; background: transparent; border: none; outline: none; color: var(--text); resize: none; overflow: hidden; }
    .main-headline.invisible-input { text-align: center; border-bottom: 2px dashed transparent; }
    .main-headline.invisible-input:hover, .main-headline.invisible-input:focus { border-bottom: 2px dashed var(--border); }
    
    .sleek-toolbar { border: none !important; border-bottom: 1px solid var(--border-muted) !important; padding: 10px 0 !important; margin-bottom: 20px; text-align: center; opacity: 0.7; transition: opacity 0.3s ease; }
    .sleek-toolbar:hover, .text-mode-area:focus-within .sleek-toolbar { opacity: 1; }
    :global(.ql-snow .ql-stroke) { stroke: var(--text) !important; }
    :global(.ql-snow .ql-fill) { fill: var(--text) !important; }
    :global(.ql-snow .ql-picker) { color: var(--text) !important; }
    :global(.ql-snow.ql-toolbar button:hover .ql-stroke) { stroke: var(--theme-color, #ef4444) !important; }
    
    .text-editor { font-family: 'Poppins', sans-serif; font-size: 1.05rem; line-height: 1.8; text-align: left; border: none !important; padding: 0 10px !important; border-left: 2px dashed transparent !important; transition: border-color 0.2s; }
    .text-editor:hover, .text-editor:focus-within { border-left: 2px dashed var(--border) !important; }
    :global(.ql-editor) { padding: 0 !important; }

    /* --- CSS BAWAAN HALAMAN BACA --- */
    .article-wrapper { width: 100%; max-width: 800px; margin: 0 auto; padding: 40px 20px 100px 20px; box-sizing: border-box; }
    .header-section { text-align: center; margin-bottom: 40px; }
    .main-headline { font-family: 'Poppins', sans-serif; font-size: 2.2rem; font-weight: 700; line-height: 1.3; color: var(--text); margin-bottom: 20px; word-break: normal; overflow-wrap: break-word; }
    .meta-row { display: flex; justify-content: center; gap: 10px; flex-wrap: wrap; }
    .meta-pill { display: flex; align-items: center; gap: 6px; background: var(--bg-light); border: 1px solid var(--border-muted); padding: 6px 12px; border-radius: 50px; font-size: 0.8rem; font-weight: 600; color: var(--text-muted); }
    .cat-link { text-decoration: none; cursor: pointer; transition: all 0.2s; }
    .cat-link:hover { background: var(--text) !important; color: var(--bg) !important; border-color: var(--text) !important; }
    
    .featured-image { width: 100%; margin-bottom: 40px; border-radius: 12px; overflow: hidden; border: 1px solid var(--border-muted); }
    .featured-image img { width: 100%; height: auto; display: block; }

    /* --- FIX PROBLEM ENTER 2X (VERSI PAMUNGKAS) --- */
    .article-content { 
        font-family: 'Poppins', sans-serif; 
        font-size: 1.05rem; 
        line-height: 1.8; 
        color: var(--text); 
        text-align: left; 
    }
    .article-content :global(p) { 
        margin-top: 0 !important; 
        margin-bottom: 0.2rem !important; 
    }
    .article-content :global(p:empty), 
    .article-content :global(p:has(> br:only-child)) { 
        margin-bottom: 0 !important; 
    }

    .footer-actions { margin-top: 60px; padding-top: 30px; border-top: 1px solid var(--border-muted); display: flex; justify-content: center; gap: 15px; }
    .action-btn { background: transparent; border: 1px solid var(--border); padding: 10px 20px; border-radius: 50px; cursor: pointer; display: flex; align-items: center; gap: 8px; font-weight: 600; color: var(--text); transition: all 0.2s; }
    .action-btn:hover { background: var(--text); color: var(--bg); border-color: var(--text); }
    .action-btn.saved { background: var(--text); color: var(--bg); border-color: var(--text); }
    
    /* =========================================
       RESPONSIVE MOBILE (UX OVERHAUL)
       ========================================= */
    @media (max-width: 768px) { 
        .article-wrapper { 
            /* KUNCI FIX OVERLAP: Padding bawah diperbesar ke 180px agar teks bisa discroll lewat tombol */
            padding: 25px 15px 180px 15px; 
        } 
        
        .header-section { margin-bottom: 25px; text-align: left; }
        .main-headline { font-size: 1.5rem; line-height: 1.4; margin-bottom: 15px; text-align: left; }
        .meta-row { justify-content: flex-start; gap: 8px; }
        .meta-pill { font-size: 0.75rem; padding: 4px 10px; }
        .featured-image { margin-bottom: 25px; border-radius: 8px; }
        
        /* --- PENYESUAIAN PANEL ADMIN DI HP --- */
        .admin-action-panel { flex-direction: column; align-items: flex-start; padding: 15px; }
        .panel-buttons { width: 100%; }
