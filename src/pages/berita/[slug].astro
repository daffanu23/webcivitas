---
import Layout from '../../layouts/Layout.astro';
import { getSupabaseServer } from '../../lib/supabase'; 
import { Calendar, User, Share2, Bookmark, CheckCircle, XCircle, RotateCcw, Lock, Unlock, Save, PenTool, Palette } from 'lucide-react'; 
import ArticleMetaFields from '../../components/ArticleMetaFields.jsx';
import AdminCoverUploader from '../../components/AdminCoverUploader.jsx';
import '../../styles/components/article-meta-fields.css';
import '../../styles/components/profile-combo-select.css';
import '../../styles/components/admin-cover-uploader.css';

export const prerender = false;

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/404');

const supabase = getSupabaseServer(Astro.cookies);
const { data: { user } } = await supabase.auth.getUser();

let isAdmin = false;
if (user) {
    const { data: profile } = await supabase
        .from('profiles')
        .select('role')
        .eq('id', user.id)
        .single();
    if (profile?.role === 'admin') isAdmin = true;
}

const { data: article, error } = await supabase
    .from('articles')
    .select(`
        *, 
        profiles!author_id ( full_name ),
        editor:profiles!editor_id ( full_name ),
        layouter:profiles!layouter_id ( full_name ),
        article_categories ( categories ( name, slug ) ) 
    `)
    .eq('slug', slug)
    .single();

if (error || !article) return Astro.redirect('/404');
if (!isAdmin && article.status !== 'published') return Astro.redirect('/404');

const authorName = article.profiles?.full_name || 'Redaksi';
const editorName = article.editor?.full_name || null;
const layouterName = article.layouter?.full_name || null;
const publishDate = new Date(article.created_at).toLocaleDateString('id-ID', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });

const htmlContent = article.content || '<p>Konten tidak tersedia.</p>';



// Ambil data kategori untuk dipakai di dropdown mode admin
const { data: categories } = await supabase.from('categories').select('*').order('name');

// TAMBAHAN: Logika Mode Dewa
const showAdminPanel = isAdmin && article.status === 'pending';
const isPending = article.status === 'pending';
const initialEditMode = isAdmin && isPending;

// Build canonical URL untuk share & OG tags
const siteUrl = Astro.site?.origin || 'https://webcivitas.vercel.app';
const canonicalUrl = `${siteUrl}/berita/${slug}`;

// Extract excerpt untuk OG description
const plainText = (article.content || '').replace(/<[^>]*>/g, '').replace(/\s+/g, ' ').trim();
const articleExcerpt = plainText.substring(0, 160) + (plainText.length > 160 ? '...' : '');
---

{/* 1. KITA LOAD CSS QUILL UNTUK SEMUA ORANG (Agar tampilan baca sama persis dengan editor) */}
<link href="https://cdn.jsdelivr.net/npm/quill@2.0.2/dist/quill.snow.css" rel="stylesheet" />

{/* Script JS editor-nya baru di-load hanya untuk Admin */}
{isAdmin && (
    <script is:inline src="https://cdn.jsdelivr.net/npm/quill@2.0.2/dist/quill.js"></script>
    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/dompurify/3.1.5/purify.min.js"></script>
)}

<script is:inline src="https://cdn.jsdelivr.net/npm/qrcode-generator@1.4.4/qrcode.js"></script>

<Layout title={`${article.title} | MEDIACIVITAS`} description={articleExcerpt} ogImage={article.cover_url} ogUrl={canonicalUrl}>

    <article class="article-wrapper">
        
        {/* TAMBAHAN: TOMBOL TOGGLE PENGAMAN */}
        {isAdmin && !isPending && (
            <button id="btn-toggle-admin" class="floating-admin-toggle">
                <span class="icon-lock"><Lock size={18} /></span>
                <span class="icon-unlock hidden"><Unlock size={18} /></span>
                <span class="toggle-text">Buka Mode Admin</span>
            </button>
        )}

        {/* TAMBAHAN: Panel dibungkus div untuk di-hide/show jika sudah tayang */}
        {isAdmin && (
            <div id="admin-action-panel" class={`admin-action-panel ${initialEditMode ? '' : 'hidden'}`}>
                <div class="panel-info">
                    <span class="badge-pending">{isPending ? 'Menunggu ACC' : 'Mode Admin Aktif'}</span>
                    <p>{isPending ? 'Anda bisa langsung mengedit Judul dan Teks di bawah (Rich Text), lalu klik aksi.' : 'Edit teks bebas, takedown, atau kembalikan ke revisi.'}</p>
                </div>
                
                <input type="hidden" id="admin-article-id" value={article.id} />
                
                <div class="panel-buttons">
                    {isPending ? (
                        <>
                            <button class="btn-admin-reject" id="btn-reject" title="Tolak Sepenuhnya (Rejected)">
                                <XCircle size={18} /> Tolak
                            </button>
                            <button class="btn-admin-revise" id="btn-revise" title="Kembalikan ke Penulis (Draft)">
                                <RotateCcw size={18} /> Revisi
                            </button>
                            <button class="btn-admin-approve" id="btn-approve" title="Simpan Editan & Tayangkan">
                                <CheckCircle size={18} /> ACC & Tayangkan
                            </button>
                        </>
                    ) : (
                        <>
                            <button class="btn-admin-reject" id="btn-takedown" title="Tarik dari peredaran (Rejected)"><XCircle size={18} /> Takedown</button>
                            <button class="btn-admin-revise" id="btn-draft" title="Kembalikan ke Penulis (Draft)"><RotateCcw size={18} /> Jadikan Draft</button>
                            <button class="btn-admin-approve" id="btn-update-text" title="Simpan perubahan teks saja"><Save size={18} /> Simpan Teks</button>
                        </>
                    )}
                </div>
            </div>
        )}

        <header class="header-section">
            {/* TAMBAHAN: Render text normal DAN textarea editor sekaligus, diatur hidden/shownya */}
            <h1 id="view-title" class={`main-headline ${initialEditMode ? 'hidden' : ''}`}>{article.title}</h1>
            
            {isAdmin && (
                <textarea id="edit-title" class={`main-headline invisible-input auto-resize ${initialEditMode ? '' : 'hidden'}`} rows="1" placeholder="Ketik Judul...">{article.title}</textarea>
            )}

            <div id="meta-view-mode" class={`meta-row ${initialEditMode ? 'hidden' : ''}`}>
                <div class="meta-pill"><User size={14} /> <span>{authorName}</span></div>
                <div class="meta-pill"><Calendar size={14} /> <span>{publishDate}</span></div>
                {editorName && <div class="meta-pill"><PenTool size={14} /> <span>Editor: {editorName}</span></div>}
                {layouterName && <div class="meta-pill"><Palette size={14} /> <span>Layouter: {layouterName}</span></div>}
                
                {article.article_categories && article.article_categories.map((ac: any) => (
                    ac.categories && (
                        <a href={`/berita?kategori=${ac.categories.slug}`} class="meta-pill cat-link">
                            {ac.categories.name}
                        </a>
                    )
                ))}
            </div>

            {isAdmin && (
                <div id="meta-edit-mode" class={initialEditMode ? '' : 'hidden'}>
                    <ArticleMetaFields 
                        client:load 
                        isAdmin={isAdmin}
                        categories={(categories || []) as any}
                        initialCategory={article.article_categories?.[0]?.categories?.id || ''}
                        initialAuthor={article.author_id || ''}
                        initialEditor={article.editor_id || ''}
                        initialLayouter={article.layouter_id || ''}
                        currentUserId={user?.id}
                        currentUserName={article.profiles?.full_name || 'Redaksi'}
                    />
                </div>
            )}
        </header>

        {article.cover_url && (
            <div class="featured-image">
                <img src={article.cover_url} alt={article.title} transition:name={`hero-${slug}`} decoding="async" />
                {isAdmin && (
                    <div id="admin-cover-overlay" class={initialEditMode ? '' : 'hidden'}>
                        <AdminCoverUploader 
                            client:load 
                            id={article.id} 
                            currentCoverUrl={article.cover_url} 
                        />
                    </div>
                )}
            </div>
        )}

        {/* TAMBAHAN: Pisahkan mode View dan Edit */}
        <div id="view-content" class={`article-content ql-snow ${initialEditMode ? 'hidden' : ''}`}>
            <div class="ql-editor" style="padding: 0;" set:html={htmlContent}></div>
        </div>

        {isAdmin && (
            <div id="edit-content-wrapper" class={`text-mode-area ${initialEditMode ? '' : 'hidden'}`}>
                <div id="quill-toolbar" class="sleek-toolbar">
                    <span class="ql-formats">
                        <button class="ql-bold" title="Tebal"></button>
                        <button class="ql-italic" title="Miring"></button>
                        <button class="ql-underline" title="Garis Bawah"></button>
                    </span>
                    <span class="ql-formats">
                        <button class="ql-header" value="2" title="Sub-Judul (H2)"></button>
                        <button class="ql-header" value="3" title="Sub-Judul Kecil (H3)"></button>
                    </span>
                    <span class="ql-formats">
                        <button class="ql-list" value="ordered" title="Daftar Angka"></button>
                        <button class="ql-list" value="bullet" title="Daftar Titik"></button>
                    </span>
                </div>
                <div id="inline-content-editor" class="article-content text-editor">
                    <Fragment set:html={htmlContent} />
                </div>
            </div>
        )}

        <div id="footer-actions-view" class={`footer-actions ${initialEditMode ? 'hidden' : ''}`}>
            {article.status === 'published' && (
                <>
                    <button class="action-btn" id="share-btn" data-url={canonicalUrl} data-title={article.title}><Share2 size={18} /> <span>Bagikan</span></button>
                    <button class="action-btn" id="bookmark-btn" data-id={article.id}><Bookmark size={18} className="icon-bookmark" /> <span id="bookmark-text">Simpan</span></button>
                </>
            )}
        </div>

        {article.status === 'published' && (
            <div id="share-modal" class="share-modal-overlay hidden">
                <div class="share-modal">
                    <div class="share-modal-header">
                        <h3>Bagikan Artikel</h3>
                        <button id="share-modal-close" class="share-modal-close">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                        </button>
                    </div>

                    <div class="share-tabs">
                        <button class="share-tab active" data-tab="qr">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="3" height="3"/><rect x="19" y="14" width="2" height="2"/><rect x="14" y="19" width="2" height="2"/><rect x="19" y="19" width="2" height="2"/></svg>
                            QR Code
                        </button>
                        <button class="share-tab" data-tab="link">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
                            Link
                        </button>
                    </div>

                    <div id="tab-qr" class="share-tab-content">
                        <div class="qr-display">
                            <div id="qr-code-container"></div>
                            <p class="qr-caption">{article.title}</p>
                        </div>
                        <button id="download-qr-btn" class="download-qr-btn">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                            Unduh QR Code
                        </button>
                    </div>

                    <div id="tab-link" class="share-tab-content hidden">
                        <div class="share-url-box">
                            <input type="text" id="share-url-input" value={canonicalUrl} readonly />
                            <button id="copy-url-btn" class="copy-url-btn">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                                <span>Salin</span>
                            </button>
                        </div>

                        <div class="share-divider"><span>Bagikan ke</span></div>

                        <div class="share-platforms">
                            <a id="share-wa" class="share-platform-btn whatsapp" target="_blank" rel="noopener noreferrer">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                                <span>WhatsApp</span>
                            </a>
                            <a id="share-tg" class="share-platform-btn telegram" target="_blank" rel="noopener noreferrer">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.479.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/></svg>
                                <span>Telegram</span>
                            </a>
                            <a id="share-tw" class="share-platform-btn twitter" target="_blank" rel="noopener noreferrer">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                                <span>X / Twitter</span>
                            </a>
                            <a id="share-fb" class="share-platform-btn facebook" target="_blank" rel="noopener noreferrer">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
                                <span>Facebook</span>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        )}
    </article>

</Layout>

<script>
    import { supabase } from '../../lib/supabase';
    
    document.addEventListener('astro:page-load', async () => {
        
        const textareas = document.querySelectorAll('.auto-resize');
        function resizeTextarea(el: HTMLTextAreaElement) {
            el.style.height = 'auto'; el.style.height = (el.scrollHeight) + 'px';
        }
        textareas.forEach(el => {
            const textarea = el as HTMLTextAreaElement;
            if(textarea.value) resizeTextarea(textarea);
            textarea.addEventListener('input', function() { resizeTextarea(this); });
        });

        // TAMBAHAN: Setup Quill dipindah ke function agar bisa dipanggil saat tombol diklik
        let adminQuill: any = null;
        function initQuillOnce() {
            if (!adminQuill && document.getElementById('inline-content-editor') && typeof window !== 'undefined' && (window as any).Quill) {
                adminQuill = new (window as any).Quill('#inline-content-editor', {
                    theme: 'snow',
                    modules: { toolbar: '#quill-toolbar' },
                    placeholder: 'Edit teks artikel...'
                });
            }
        }

        let isEditMode = !document.getElementById('edit-content-wrapper')?.classList.contains('hidden');
        if (isEditMode) initQuillOnce();

        // TAMBAHAN: Aksi Klik Tombol Toggle
        const btnToggleAdmin = document.getElementById('btn-toggle-admin');
        if (btnToggleAdmin) {
            btnToggleAdmin.addEventListener('click', () => {
                isEditMode = !isEditMode; 
                initQuillOnce(); 
                
                const iconLock = btnToggleAdmin.querySelector('.icon-lock');
                const iconUnlock = btnToggleAdmin.querySelector('.icon-unlock');
                const toggleText = btnToggleAdmin.querySelector('.toggle-text');
                
                document.getElementById('view-title')?.classList.toggle('hidden', isEditMode);
                document.getElementById('edit-title')?.classList.toggle('hidden', !isEditMode);
                document.getElementById('meta-view-mode')?.classList.toggle('hidden', isEditMode);
                document.getElementById('meta-edit-mode')?.classList.toggle('hidden', !isEditMode);
                document.getElementById('view-content')?.classList.toggle('hidden', isEditMode);
                document.getElementById('edit-content-wrapper')?.classList.toggle('hidden', !isEditMode);
                document.getElementById('admin-action-panel')?.classList.toggle('hidden', !isEditMode);
                document.getElementById('footer-actions-view')?.classList.toggle('hidden', isEditMode);
                document.getElementById('admin-cover-overlay')?.classList.toggle('hidden', !isEditMode);

                if (isEditMode) {
                    btnToggleAdmin.classList.add('active');
                    if (toggleText) toggleText.textContent = "Tutup Mode Admin";
                    iconLock?.classList.add('hidden');
                    iconUnlock?.classList.remove('hidden');
                    const editTitle = document.getElementById('edit-title');
                    if (editTitle) resizeTextarea(editTitle as HTMLTextAreaElement);
                } else {
                    btnToggleAdmin.classList.remove('active');
                    if (toggleText) toggleText.textContent = "Buka Mode Admin";
                    iconLock?.classList.remove('hidden');
                    iconUnlock?.classList.add('hidden');
                }
            });
        }

        const articleId = document.getElementById('admin-article-id') as HTMLInputElement;

        async function processAdminAction(newStatus: string, confirmMsg: string, successMsg: string, btnId: string) {
            if (!confirm(confirmMsg)) return;
            
            const btn = document.getElementById(btnId);
            const originalText = btn ? btn.innerHTML : '';
            if (btn) btn.innerHTML = "Memproses...";

            const updateData: any = { status: newStatus };
            
            const titleInput = document.getElementById('edit-title') as HTMLTextAreaElement;
            if (titleInput) updateData.title = titleInput.value.trim();

            const categoryInput = document.getElementById('input-category') as HTMLInputElement;
            const authorInput = document.getElementById('input-author') as HTMLInputElement;
            const editorInput = document.getElementById('input-editor') as HTMLInputElement;
            const layouterInput = document.getElementById('input-layouter') as HTMLInputElement;

            if (authorInput) updateData.author_id = authorInput.value || null;
            if (editorInput) updateData.editor_id = editorInput.value || null;
            if (layouterInput) updateData.layouter_id = layouterInput.value || null;

            if (adminQuill) {
                let rawHtml = adminQuill.root.innerHTML;
                if (rawHtml === '<p><br></p>') rawHtml = ''; 
                updateData.content = (window as any).DOMPurify ? (window as any).DOMPurify.sanitize(rawHtml) : rawHtml;
            }

            const { error } = await supabase
                .from('articles')
                .update(updateData)
                .eq('id', articleId.value);
                
            // Update kategori di tabel article_categories jika categoryInput ada (Admin Mode)
            if (categoryInput && categoryInput.value && !error) {
                await supabase.from('article_categories').delete().eq('article_id', articleId.value);
                await supabase.from('article_categories').insert({ article_id: articleId.value, category_id: categoryInput.value });
            }
                
            if (error) {
                alert("Gagal memproses: " + error.message);
                if (btn) btn.innerHTML = originalText;
            } else {
                alert(successMsg);
                if (newStatus === 'published') {
                    window.location.reload(); 
                } else {
                    window.location.href = '/'; 
                }
            }
        }

        if (articleId) {
            // Tombol Pending
            document.getElementById('btn-approve')?.addEventListener('click', () => 
                processAdminAction('published', 'ACC dan tayangkan ke publik dengan editan ini?', 'BOM! 🚀 Artikel berhasil ditayangkan!', 'btn-approve')
            );
            document.getElementById('btn-revise')?.addEventListener('click', () => 
                processAdminAction('draft', 'Kembalikan artikel ini ke penulis (Draft) untuk direvisi?', 'Artikel dikembalikan ke status Draft.', 'btn-revise')
            );
            document.getElementById('btn-reject')?.addEventListener('click', () => 
                processAdminAction('rejected', 'Tolak artikel ini secara permanen (Rejected)?', 'Artikel telah ditolak (Rejected).', 'btn-reject')
            );

            // TAMBAHAN: Tombol Published Mode
            document.getElementById('btn-takedown')?.addEventListener('click', () => 
                processAdminAction('rejected', 'Yakin ingin melakukan TAKEDOWN pada artikel ini?', 'Artikel berhasil di-takedown.', 'btn-takedown')
            );
            document.getElementById('btn-draft')?.addEventListener('click', () => 
                processAdminAction('draft', 'Tarik artikel ini ke Draft untuk direvisi?', 'Artikel ditarik menjadi Draft.', 'btn-draft')
            );
            document.getElementById('btn-update-text')?.addEventListener('click', () => 
                processAdminAction('published', 'Simpan perbaikan teks pada artikel ini?', 'Perbaikan teks berhasil disimpan!', 'btn-update-text')
            );
        }

        // === SHARE MODAL LOGIC ===
        const btnShare = document.getElementById('share-btn');
        const shareModal = document.getElementById('share-modal');

        if (btnShare && shareModal) {
            const shareUrl = btnShare.getAttribute('data-url') || '';
            const shareTitle = btnShare.getAttribute('data-title') || '';
            const shareText = `${shareTitle} - Baca selengkapnya di MEDIACIVITAS`;

            // Set share platform URLs
            const waBtn = document.getElementById('share-wa') as HTMLAnchorElement;
            const tgBtn = document.getElementById('share-tg') as HTMLAnchorElement;
            const twBtn = document.getElementById('share-tw') as HTMLAnchorElement;
            const fbBtn = document.getElementById('share-fb') as HTMLAnchorElement;

            if (waBtn) waBtn.href = `https://wa.me/?text=${encodeURIComponent(shareText + '\n' + shareUrl)}`;
            if (tgBtn) tgBtn.href = `https://t.me/share/url?url=${encodeURIComponent(shareUrl)}&text=${encodeURIComponent(shareText)}`;
            if (twBtn) twBtn.href = `https://twitter.com/intent/tweet?url=${encodeURIComponent(shareUrl)}&text=${encodeURIComponent(shareTitle)}`;
            if (fbBtn) fbBtn.href = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(shareUrl)}`;

            // Open modal
            btnShare.addEventListener('click', () => {
                if (shareModal) document.body.appendChild(shareModal);
                shareModal?.classList.remove('hidden');
                requestAnimationFrame(() => shareModal?.classList.add('show'));
                generateQR(shareUrl);
            });

            // Close modal
            function closeShareModal() {
                shareModal?.classList.remove('show');
                setTimeout(() => shareModal?.classList.add('hidden'), 300);
            }
            document.getElementById('share-modal-close')?.addEventListener('click', closeShareModal);
            shareModal.addEventListener('click', (e: Event) => {
                if (e.target === shareModal) closeShareModal();
            });
            document.addEventListener('keydown', (e: KeyboardEvent) => {
                if (e.key === 'Escape' && !shareModal?.classList.contains('hidden')) closeShareModal();
            });

            // Tab switching
            const shareTabs = shareModal.querySelectorAll('.share-tab');
            shareTabs.forEach(tab => {
                tab.addEventListener('click', () => {
                    const targetTab = tab.getAttribute('data-tab');
                    shareTabs.forEach(t => t.classList.remove('active'));
                    tab.classList.add('active');
                    shareModal.querySelectorAll('.share-tab-content').forEach(c => c.classList.add('hidden'));
                    document.getElementById(`tab-${targetTab}`)?.classList.remove('hidden');
                    if (targetTab === 'qr') generateQR(shareUrl);
                });
            });

            // Copy URL
            const copyBtn = document.getElementById('copy-url-btn');
            if (copyBtn) {
                copyBtn.addEventListener('click', () => {
                    navigator.clipboard.writeText(shareUrl).then(() => {
                        const span = copyBtn.querySelector('span');
                        if (span) { span.textContent = 'Tersalin!'; copyBtn.classList.add('copied'); }
                        setTimeout(() => { if (span) { span.textContent = 'Salin'; copyBtn.classList.remove('copied'); } }, 2000);
                    });
                });
            }

            // QR Code generation
            let qrGenerated = false;
            function generateQR(url: string) {
                if (qrGenerated) return;
                const container = document.getElementById('qr-code-container');
                if (!container) return;
                const qrFunc = (window as any).qrcode;
                if (typeof qrFunc !== 'function') {
                    container.innerHTML = '<p style="color:var(--text-muted);font-size:0.85rem;text-align:center;">Gagal memuat QR generator.</p>';
                    return;
                }
                const qr = qrFunc(0, 'M');
                qr.addData(url);
                qr.make();
                container.innerHTML = qr.createSvgTag(5, 4);
                qrGenerated = true;
            }

            // Download QR as PNG
            document.getElementById('download-qr-btn')?.addEventListener('click', () => {
                const svg = document.querySelector('#qr-code-container svg') as SVGElement;
                if (!svg) return;
                const canvas = document.createElement('canvas');
                const size = 600;
                canvas.width = size; canvas.height = size;
                const ctx = canvas.getContext('2d');
                if (!ctx) return;
                const svgData = new XMLSerializer().serializeToString(svg);
                const img = new Image();
                img.onload = () => {
                    ctx.fillStyle = '#ffffff';
                    ctx.fillRect(0, 0, size, size);
                    ctx.drawImage(img, 0, 0, size, size);
                    const a = document.createElement('a');
                    a.download = 'qrcode-mediacivitas.png';
                    a.href = canvas.toDataURL('image/png');
                    a.click();
                };
                img.src = 'data:image/svg+xml;base64,' + btoa(unescape(encodeURIComponent(svgData)));
            });
        }
        
        const btnBookmark = document.getElementById('bookmark-btn');
        const iconBookmark = document.querySelector('.icon-bookmark');
        const textBookmark = document.getElementById('bookmark-text');
        
        if (btnBookmark && iconBookmark) {
            const bArticleId = btnBookmark.getAttribute('data-id');
            const { data: { session } } = await supabase.auth.getSession();
            
            if (session) {
                const { data } = await supabase.from('bookmarks').select('id').eq('user_id', session.user.id).eq('article_id', bArticleId).single();
                if (data) {
                    btnBookmark.classList.add('saved'); iconBookmark.setAttribute('fill', 'currentColor'); if(textBookmark) textBookmark.innerText = "Tersimpan";
                }
            }
            
            btnBookmark.addEventListener('click', async () => {
                if (!session) return window.location.href = '/login';
                const isSaved = btnBookmark.classList.contains('saved');
                if (isSaved) {
                    const { error } = await supabase.from('bookmarks').delete().eq('user_id', session.user.id).eq('article_id', bArticleId);
                    if (!error) { btnBookmark.classList.remove('saved'); iconBookmark.setAttribute('fill', 'none'); if(textBookmark) textBookmark.innerText = "Simpan"; }
                } else {
                    const { error } = await supabase.from('bookmarks').insert({ user_id: session.user.id, article_id: bArticleId });
                    if (!error) { btnBookmark.classList.add('saved'); iconBookmark.setAttribute('fill', 'currentColor'); if(textBookmark) textBookmark.innerText = "Tersimpan"; }
                }
            });
        }
    });
</script>

