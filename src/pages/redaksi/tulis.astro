---
import Layout from '../../layouts/Layout.astro';
import { getSupabaseServer } from '../../lib/supabase';
import { Calendar, User, UploadCloud, FileText, Send, X, ChevronDown, Camera, Save, Loader2, CheckCircle } from 'lucide-react';

// 1. Inisialisasi Auth Server
const supabase = getSupabaseServer(Astro.cookies);
const { data: { user }, error: authError } = await supabase.auth.getUser();

if (authError || !user) {
    return Astro.redirect('/login');
}

// 2. Cek Role & Nama Penulis
const { data: profile } = await supabase
    .from('profiles')
    .select('full_name, role')
    .eq('id', user.id)
    .single();

if (!profile || (profile.role !== 'redaksi' && profile.role !== 'admin')) {
    return Astro.redirect('/');
}

const authorName = profile.full_name || 'Redaksi';
const isAdmin = profile.role === 'admin'; 
const todayDate = new Date().toLocaleDateString('id-ID', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });

// 3. Ambil Kategori
const { data: categories } = await supabase.from('categories').select('*').order('name');

// 4. Deteksi Mode & Data Edit
const slug = Astro.url.searchParams.get('slug');
const mode = Astro.url.searchParams.get('mode') || 'teks'; 

let initialArticle = null;
let initialSelectedCategories = [] as string[];

if (slug) {
    const { data: article } = await supabase.from('articles').select('*').eq('slug', slug).single();
    if (article) {
        initialArticle = article;
        const { data: pivot } = await supabase.from('article_categories').select('category_id').eq('article_id', article.id);
        if (pivot) {
            initialSelectedCategories = pivot.map(p => p.category_id);
        }
    }
}
---

<link href="https://cdn.jsdelivr.net/npm/quill@2.0.2/dist/quill.snow.css" rel="stylesheet" />
<script is:inline src="https://cdn.jsdelivr.net/npm/quill@2.0.2/dist/quill.js"></script>
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/dompurify/3.1.5/purify.min.js"></script>
<script is:inline src="https://cdn.jsdelivr.net/npm/browser-image-compression@2.0.2/dist/browser-image-compression.js"></script>

<Layout title={initialArticle ? "Edit Berita | MEDIACIVITAS" : "Tulis Berita Baru | MEDIACIVITAS"}>
    <div class="editor-container">
        
        <button type="button" class="btn-close-editor" onclick="history.back()" title="Batal Menulis">
            <X size={24} />
        </button>

        <form id="editor-form" class="article-wrapper">
            
            <input type="hidden" id="post-mode" value={mode} />
            <input type="hidden" id="post-id" value={initialArticle?.id || ''} />
            <input type="hidden" id="user-id" value={user.id} />
            
            <header class="header-section">
                <textarea 
                    id="input-title" 
                    class="main-headline invisible-input auto-resize" 
                    placeholder="Ketik Judul Berita Di Sini..." 
                    rows="2" 
                    required
                >{initialArticle?.title || ''}</textarea>

                <div class="meta-row">
                    <div class="meta-pill"><User size={14} /> <span>{authorName}</span></div>
                    <div class="meta-pill"><Calendar size={14} /> <span>{todayDate}</span></div>
                    
                    {/* --- CUSTOM DROPDOWN KATEGORI (CLEAN UI) --- */}
                    <div class="meta-pill custom-dropdown-wrapper" id="category-dropdown-wrapper">
                        {/* Hidden input penyimpan ID Kategori untuk dikirim ke Database */}
                        <input type="hidden" id="input-category" value={initialSelectedCategories.length > 0 ? initialSelectedCategories[0] : ''} required />
                        
                        {/* Tombol Pemicu Dropdown */}
                        <div class="dropdown-trigger" id="dropdown-trigger">
                            <span id="selected-category-text">
                                {initialSelectedCategories.length > 0 
                                    ? categories?.find(c => c.id === initialSelectedCategories[0])?.name || 'Pilih Kategori'
                                    : 'Pilih Kategori'}
                            </span>
                            <ChevronDown size={14} className="dropdown-icon" />
                        </div>

                        {/* Menu Melayang (Custom UI) */}
                        <div class="dropdown-menu" id="dropdown-menu">
                            {categories && categories.map(cat => (
                                <div 
                                    class={`dropdown-item ${initialSelectedCategories.includes(cat.id) ? 'active' : ''}`}
                                    data-value={cat.id}
                                    data-name={cat.name}
                                >
                                    {cat.name}
                                </div>
                            ))}
                        </div>
                    </div>
                </div>
            </header>

            <div class="cover-upload-area" id="cover-dropzone">
                <input type="file" id="input-cover" accept="image/*" class="hidden-file-input" />
                
                <div class={`cover-placeholder ${initialArticle?.cover_url ? 'has-image' : ''}`} id="cover-preview-container" data-url={initialArticle?.cover_url || ''}>
                    {initialArticle?.cover_url ? (
                        <>
                            <img src={initialArticle.cover_url} alt="Cover Preview" class="cover-img-preview" />
                            <div class="change-cover-overlay">
                                <button type="button" class="btn-change-cover">
                                    <Camera size={18} /> Ganti Cover
                                </button>
                            </div>
                        </>
                    ) : (
                        <div class="cover-empty-state">
                            <UploadCloud size={32} />
                            <span>Klik untuk unggah Cover Utama (Wajib)</span>
                        </div>
                    )}
                </div>
            </div>

            <div class="text-mode-area">
                <div id="quill-toolbar" class="sleek-toolbar">
                    <span class="ql-formats">
                        <button class="ql-bold" title="Tebal"></button>
                        <button class="ql-italic" title="Miring"></button>
                        <button class="ql-underline" title="Garis Bawah"></button>
                    </span>
                    <span class="ql-formats">
                        <button class="ql-header" value="2" title="Sub-Judul (H2)"></button>
                        <button class="ql-header" value="3" title="Sub-Judul Kecil (H3)"></button>
                    </span>
                    <span class="ql-formats">
                        <button class="ql-list" value="ordered" title="Daftar Angka"></button>
                        <button class="ql-list" value="bullet" title="Daftar Titik"></button>
                    </span>
                    <span class="ql-formats">
                        <button class="ql-link" title="Masukkan Link"></button>
                        <button class="ql-clean" title="Bersihkan Format"></button>
                    </span>
                </div>

                <div id="input-content-editor" class="article-content text-editor">
                    {initialArticle?.content ? <Fragment set:html={initialArticle.content} /> : ''}
                </div>
            </div>

            <div class="footer-actions">
                <button type="button" class="action-btn btn-draft" id="btn-save-draft">
                    <Save size={18} className="btn-icon" /> 
                    <Loader2 size={18} className="btn-spinner hidden" />
                    <span class="btn-text">Simpan Draft</span>
                </button>
                
                {isAdmin ? (
                    <button type="button" class="action-btn btn-submit btn-publish-direct" id="btn-publish-direct">
                        <CheckCircle size={18} className="btn-icon" />
                        <Loader2 size={18} className="btn-spinner hidden" />
                        <span class="btn-text">Tayangkan Langsung</span>
                    </button>
                ) : (
                    <button type="button" class="action-btn btn-submit" id="btn-submit-admin">
                        <Send size={18} className="btn-icon" />
                        <Loader2 size={18} className="btn-spinner hidden" />
                        <span class="btn-text">Kirim ke Admin</span>
                    </button>
                )}
            </div>
            
        </form>
    </div>
</Layout>

<script>
    import { supabase } from '../../lib/supabase';

    document.addEventListener('astro:page-load', () => {
        // --- 1. SETUP UI & RESIZE UNTUK JUDUL ---
        const textareas = document.querySelectorAll('.auto-resize');
        function resizeTextarea(el: HTMLTextAreaElement) {
            el.style.height = 'auto'; el.style.height = (el.scrollHeight) + 'px';
        }
        textareas.forEach(el => {
            const textarea = el as HTMLTextAreaElement;
            if(textarea.value) resizeTextarea(textarea);
            textarea.addEventListener('input', function() { resizeTextarea(this); });
        });

        // --- 2. SETUP CUSTOM DROPDOWN KATEGORI ---
        const dropdownWrapper = document.getElementById('category-dropdown-wrapper');
        const trigger = document.getElementById('dropdown-trigger');
        const menu = document.getElementById('dropdown-menu');
        const inputCategory = document.getElementById('input-category') as HTMLInputElement;
        const selectedText = document.getElementById('selected-category-text');

        if (dropdownWrapper && trigger && menu && inputCategory && selectedText) {
            trigger.addEventListener('click', (e) => {
                e.stopPropagation();
                dropdownWrapper.classList.toggle('open');
            });

            const items = menu.querySelectorAll('.dropdown-item');
            items.forEach(item => {
                item.addEventListener('click', (e) => {
                    e.stopPropagation(); 
                    const val = item.getAttribute('data-value');
                    const name = item.getAttribute('data-name');
                    
                    if (val && name) {
                        inputCategory.value = val;
                        selectedText.textContent = name;
                        selectedText.style.color = 'var(--text)'; // Update teks jadi tegas
                        
                        items.forEach(i => i.classList.remove('active'));
                        item.classList.add('active');
                    }
                    dropdownWrapper.classList.remove('open');
                });
            });

            document.addEventListener('click', (e) => {
                if (!dropdownWrapper.contains(e.target as Node)) {
                    dropdownWrapper.classList.remove('open');
                }
            });
        }

        // --- 3. INISIALISASI QUILL ---
        let quillEditor: any;
        if (typeof window !== 'undefined' && (window as any).Quill) {
            quillEditor = new (window as any).Quill('#input-content-editor', {
                theme: 'snow',
                modules: { toolbar: '#quill-toolbar' },
                placeholder: 'Mulai menulis atau Paste artikel Word Anda di sini...'
            });
        }

        // --- 4. UPLOAD & KOMPRESI GAMBAR ---
        let coverFile: File | null = null;
        const coverInput = document.getElementById('input-cover') as HTMLInputElement;
        const coverContainer = document.getElementById('cover-preview-container');
        
        if (coverInput && coverContainer) {
            coverContainer.addEventListener('click', () => coverInput.click());
            
            coverInput.addEventListener('change', async function() {
                if (this.files && this.files[0]) {
                    const originalFile = this.files[0];
                    coverContainer.classList.remove('has-image');
                    coverContainer.innerHTML = `
                        <div class="cover-empty-state">
                            <div class="spinner-custom"></div>
                            <span style="color: var(--text);">Mengompres Gambar... ⏳</span>
                        </div>
                    `;

                    try {
                        const options = { maxSizeMB: 0.3, maxWidthOrHeight: 1280, useWebWorker: true };
                        if ((window as any).imageCompression) {
                            coverFile = await (window as any).imageCompression(originalFile, options);
                        } else {
                            coverFile = originalFile; 
                        }
                    } catch (error) {
                        coverFile = originalFile;
                    }

                    const reader = new FileReader();
                    reader.onload = (e) => {
                        coverContainer.innerHTML = `
                            <img src="${e.target?.result}" alt="Preview Cover" class="cover-img-preview" />
                            <div class="change-cover-overlay">
                                <button type="button" class="btn-change-cover">Ganti Cover</button>
                            </div>
                        `;
                        coverContainer.classList.add('has-image');
                    };
                    reader.readAsDataURL(coverFile as File);
                }
            });
        }

        // --- 5. FUNGSI SIMPAN ARTIKEL ---
        async function saveArticle(status: 'draft' | 'pending' | 'published') {
            let btnId = 'btn-save-draft';
            if (status === 'pending') btnId = 'btn-submit-admin';
            if (status === 'published') btnId = 'btn-publish-direct';
            const btn = document.getElementById(btnId);

            const articleId = (document.getElementById('post-id') as HTMLInputElement).value;
            const userId = (document.getElementById('user-id') as HTMLInputElement).value;
            const title = (document.getElementById('input-title') as HTMLTextAreaElement).value.trim();
            const categoryId = (document.getElementById('input-category') as HTMLInputElement).value;
            
            let rawHtml = quillEditor ? quillEditor.root.innerHTML : '';
            if (rawHtml === '<p><br></p>') rawHtml = ''; 
            
            let cleanContent = rawHtml;
            if ((window as any).DOMPurify) {
                (window as any).DOMPurify.removeAllHooks();
                (window as any).DOMPurify.addHook('afterSanitizeAttributes', function(node: Element) {
                    if (node.tagName === 'A') {
                        const href = node.getAttribute('href');
                        if (href && !/^(https?:\/\/|mailto:|tel:|\/|#)/i.test(href)) {
                            node.setAttribute('href', 'https://' + href);
                        }
                        node.setAttribute('target', '_blank');
                        node.setAttribute('rel', 'noopener noreferrer');
                    }
                });
                cleanContent = (window as any).DOMPurify.sanitize(rawHtml, { ADD_ATTR: ['target'] });
            }
            
            if (!title) return alert("Judul tidak boleh kosong!");
            if (!categoryId) return alert("Pilih kategori terlebih dahulu!");
            if (!cleanContent) return alert("Isi berita tidak boleh kosong!");
            if (!coverFile && !coverContainer?.getAttribute('data-url')) return alert("Upload Cover Utama terlebih dahulu!");

            if (btn) {
                btn.setAttribute('disabled', 'true');
                btn.classList.add('is-loading');
                btn.querySelector('.btn-icon')?.classList.add('hidden');
                btn.querySelector('.btn-spinner')?.classList.remove('hidden');
                btn.querySelector('.btn-text')!.textContent = "Memproses...";
            }

            try {
                let finalCoverUrl = coverContainer?.getAttribute('data-url') || '';
                
                if (coverFile) {
                    if (articleId && finalCoverUrl && finalCoverUrl.includes('covers/')) {
                        try {
                            const oldPath = finalCoverUrl.substring(finalCoverUrl.indexOf('covers/'));
                            await supabase.storage.from('news-images').remove([oldPath]);
                        } catch(err) {}
                    }

                    const fileExt = coverFile.name.split('.').pop();
                    const uniqueName = `${Date.now()}_${Math.random().toString(36).substring(7)}.${fileExt}`;
                    const filePath = `covers/${uniqueName}`;
                    
                    const { error: uploadError } = await supabase.storage.from('news-images').upload(filePath, coverFile);
                    if (uploadError) throw new Error("Gagal mengunggah cover: " + uploadError.message);
                    
                    const { data } = supabase.storage.from('news-images').getPublicUrl(filePath);
                    finalCoverUrl = data.publicUrl; 
                }

                let slug = title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)+/g, '');
                if (!articleId) slug = `${slug}-${Math.floor(Math.random() * 1000)}`;

                const articleData = {
                    title: title,
                    slug: slug,
                    content: cleanContent, 
                    cover_url: finalCoverUrl,
                    status: status,
                    author_id: userId
                };

                let savedArticleId = articleId;

                if (articleId) {
                    const { error } = await supabase.from('articles').update(articleData).eq('id', articleId);
                    if (error) throw error;
                } else {
                    const { data, error } = await supabase.from('articles').insert(articleData).select('id').single();
                    if (error) throw error;
                    savedArticleId = data.id;
                }

                if (articleId) {
                    await supabase.from('article_categories').delete().eq('article_id', articleId);
                }
                await supabase.from('article_categories').insert({ article_id: savedArticleId, category_id: categoryId });

                alert(`Berhasil! Artikel disimpan sebagai: ${status.toUpperCase()}`);
                window.location.href = '/'; 

            } catch (err: any) {
                alert("Terjadi kesalahan: " + err.message);
            } finally {
                if (btn) {
                    btn.removeAttribute('disabled');
                    btn.classList.remove('is-loading');
                    btn.querySelector('.btn-icon')?.classList.remove('hidden');
                    btn.querySelector('.btn-spinner')?.classList.add('hidden');
                    
                    let originalText = "Simpan Draft";
                    if (status === 'pending') originalText = "Kirim ke Admin";
                    if (status === 'published') originalText = "Tayangkan Langsung";
                    btn.querySelector('.btn-text')!.textContent = originalText;
                }
            }
        }

        document.getElementById('btn-save-draft')?.addEventListener('click', () => saveArticle('draft'));
        document.getElementById('btn-submit-admin')?.addEventListener('click', () => saveArticle('pending'));
        document.getElementById('btn-publish-direct')?.addEventListener('click', () => saveArticle('published'));
    });
</script>

<style>
    /* =========================================
       CSS GLOBAL & DESKTOP EDITOR
       ========================================= */
    .editor-container { position: relative; width: 100%; min-height: 100vh; }

    .btn-close-editor {
        position: fixed; top: 30px; left: 30px; width: 45px; height: 45px;
        background: var(--bg-light); border: 1px solid var(--border); border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        color: var(--text-muted); cursor: pointer; transition: all 0.2s ease; z-index: 100;
    }
    .btn-close-editor:hover { background: #ef4444; color: #fff; border-color: #ef4444; transform: rotate(90deg); }

    .article-wrapper {
        width: 100%; max-width: 800px; margin: 0 auto;
        padding: 60px 20px 100px 20px; box-sizing: border-box;
    }

    /* --- AREA JUDUL --- */
    .invisible-input {
        width: 100%; background: transparent; border: none; outline: none;
        color: var(--text); resize: none; text-align: center; overflow: hidden;
    }
    .invisible-input::placeholder { color: var(--text-muted); opacity: 0.5; }

    .header-section { text-align: center; margin-bottom: 40px; }
    
    .main-headline { 
        font-family: 'Poppins', sans-serif; font-size: 2.2rem; font-weight: 700; line-height: 1.3; 
        margin-bottom: 20px; border-bottom: 2px dashed transparent; transition: border-color 0.2s;
    }
    .main-headline:hover, .main-headline:focus { border-bottom: 2px dashed var(--border); }

    /* --- METADATA UMUM --- */
    .meta-row { display: flex; justify-content: center; gap: 10px; flex-wrap: wrap; }
    
    .meta-pill { 
        display: flex; align-items: center; gap: 6px; background: var(--bg-light); 
        border: 1px solid var(--border-muted); padding: 6px 14px; border-radius: 50px; 
        font-size: 0.85rem; font-weight: 600; color: var(--text-muted); 
    }

    /* --- CUSTOM DROPDOWN UI --- */
    .custom-dropdown-wrapper {
        position: relative;
        cursor: pointer;
        padding: 0; /* Override padding bawaan meta-pill */
        overflow: visible; /* Penting! Agar menu dropdown tidak terpotong */
        transition: border-color 0.2s;
        user-select: none;
    }
    
    .custom-dropdown-wrapper:hover, .custom-dropdown-wrapper.open {
        border-color: var(--text);
    }

    .dropdown-trigger {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 6px 12px 6px 14px;
        min-width: 150px;
        gap: 8px;
    }
    
    .dropdown-trigger span {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        color: var(--text-muted);
    }

    .dropdown-icon {
        transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        color: var(--text);
    }
    .custom-dropdown-wrapper.open .dropdown-icon {
        transform: rotate(180deg);
        color: #ef4444;
    }

    .dropdown-menu {
        position: absolute;
        top: calc(100% + 8px);
        left: 50%;
        transform: translateX(-50%) translateY(-10px);
        width: 220px;
        background: var(--bg-light);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 8px 0;
        box-shadow: 0 15px 35px rgba(0,0,0,0.25);
        z-index: 9999;
        
        /* Animasi Buka/Tutup */
        opacity: 0;
        visibility: hidden;
        transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .custom-dropdown-wrapper.open .dropdown-menu {
        opacity: 1;
        visibility: visible;
        transform: translateX(-50%) translateY(0);
    }

    .dropdown-item {
        padding: 12px 16px;
        font-size: 0.9rem;
        color: var(--text);
        transition: background 0.2s;
        text-align: left;
    }
    .dropdown-item:hover {
        background: rgba(239, 68, 68, 0.1);
        color: #ef4444;
    }
    .dropdown-item.active {
        background: rgba(239, 68, 68, 0.1);
        color: #ef4444;
        font-weight: 700;
        border-left: 3px solid #ef4444;
        padding-left: 13px; /* Kompensasi border */
    }

    /* --- UPLOAD COVER --- */
    .hidden-file-input { display: none; }
    .cover-upload-area { margin-bottom: 40px; }
    
    .cover-placeholder {
        width: 100%; height: 250px; border: 2px dashed var(--border); border-radius: 12px;
        color: var(--text-muted); cursor: pointer; transition: all 0.2s ease;
        background: var(--bg-light); position: relative; overflow: hidden;
    }
    .cover-empty-state { width: 100%; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10px; }
    .cover-placeholder:not(.has-image):hover { border-color: var(--text); color: var(--text); }
    .cover-placeholder.has-image { border: 1px solid var(--border-muted); height: auto; }
    
    :global(.cover-img-preview) { width: 100%; height: auto; display: block; border-radius: 12px; }

    :global(.change-cover-overlay) {
        position: absolute; top: 0; left: 0; width: 100%; height: 100%;
        background: rgba(0, 0, 0, 0.5); backdrop-filter: blur(2px);
        display: flex; align-items: center; justify-content: center;
        opacity: 0; transition: opacity 0.2s ease; border-radius: 12px;
    }
    .cover-placeholder.has-image:hover :global(.change-cover-overlay) { opacity: 1; }
    
    :global(.btn-change-cover) {
        display: flex; align-items: center; gap: 8px; background: rgba(255, 255, 255, 0.95);
        color: #1a1a1a; border: none; padding: 12px 24px; border-radius: 50px;
        font-weight: 700; font-size: 0.95rem; cursor: pointer; transition: transform 0.2s;
    }
    :global(.btn-change-cover:hover) { transform: scale(1.05); }

    .spinner-custom {
        width: 32px; height: 32px; border: 4px solid var(--border); border-top: 4px solid var(--text);
        border-radius: 50%; animation: spin 1s linear infinite; margin-bottom: 10px;
    }

    /* --- EDITOR QUILL --- */
    .sleek-toolbar {
        border: none !important; border-bottom: 1px solid var(--border-muted) !important;
        padding: 10px 0 !important; margin-bottom: 20px; text-align: center; opacity: 0.7; transition: opacity 0.3s ease;
    }
    .sleek-toolbar:hover, .text-mode-area:focus-within .sleek-toolbar { opacity: 1; }
    
    :global(.ql-snow .ql-stroke) { stroke: var(--text) !important; }
    :global(.ql-snow .ql-fill) { fill: var(--text) !important; }
    :global(.ql-snow .ql-picker) { color: var(--text) !important; }
    :global(.ql-snow.ql-toolbar button:hover .ql-stroke) { stroke: var(--theme-color, #ef4444) !important; }

    .text-editor {
        font-family: 'Poppins', sans-serif; font-size: 1.05rem; line-height: 1.8; text-align: left; 
        border: none !important; padding: 0 10px !important; min-height: 400px;
        border-left: 2px dashed transparent !important; transition: border-color 0.2s;
    }
    .text-editor:hover, .text-editor:focus-within { border-left: 2px dashed var(--border) !important; }

    :global(.ql-editor) { padding: 0 !important; }
    :global(.ql-editor.ql-blank::before) { left: 0 !important; color: var(--text-muted) !important; font-style: italic; }

    /* --- TOMBOL BAWAH --- */
    .footer-actions { 
        margin-top: 60px; padding-top: 30px; border-top: 1px solid var(--border-muted); 
        display: flex; justify-content: center; gap: 15px; flex-wrap: wrap;
    }
    
    .action-btn { 
        background: transparent; border: 1px solid var(--text); padding: 14px 28px; 
        border-radius: 50px; cursor: pointer; display: flex; align-items: center; gap: 8px; 
        font-weight: 600; font-size: 0.95rem; color: var(--text); transition: all 0.2s; 
    }
    
    .action-btn:hover { background: var(--bg-light); transform: translateY(-2px); }
    .action-btn:disabled { opacity: 0.7; cursor: not-allowed; transform: none; }
    
    .btn-submit { background: var(--text); color: var(--bg); border-color: var(--text); }
